{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Api.DevHost: slim API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api-devhost",
      "program": "${workspaceFolder}/src/RetroDownfall.Arcanum.Api.DevHost/bin/Debug/net10.0/RetroDownfall.Arcanum.Api.DevHost.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": false,
      "logging": {
        "moduleLoad": false
      },
      "suppressJITOptimizations": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      }
    },
    {
      "name": "Cli: Interactive Chat (External Terminal)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cli-wait-api-port",
      "program": "${workspaceFolder}/src/RetroDownfall.Arcanum.Cli/bin/Debug/net10.0/RetroDownfall.Arcanum.Cli.dll",
      "args": [
        "chat"
      ],
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "justMyCode": false,
      "suppressJITOptimizations": true,
      "logging": {
        "moduleLoad": false
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: API + External Chat",
      "configurations": [
        "Api.DevHost: slim API",
        "Cli: Interactive Chat (External Terminal)"
      ],
      "stopAll": true
    }
  ]
}
