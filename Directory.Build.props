<Project>

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <LangVersion>latest</LangVersion>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- This also reaches NuGet's own audit-at-restore step, not only the compiler. NuGetAuditMode
         defaults to "all" (direct and transitive dependencies, not only what this repository
         references directly) for a net10.0+ TargetFramework, so a new advisory against any
         package already in the restore graph, something no commit here controls since the
         advisory feed changes independently of this repository, now fails restore everywhere
         instead of only warning: NU1901 (low), NU1902 (moderate), NU1903 (high), NU1904
         (critical). That is deliberate: fail closed on a dependency advisory is the posture this
         hardening pass wants, not a quiet merge past it. When one fires, bump the flagged package
         past the advisory; if no fixed version exists yet, add a scoped
         NuGetAuditSuppress Include="https://github.com/advisories/GHSA-..." naming the specific
         advisory with a comment saying why it is accepted for now, not
         WarningsNotAsErrors covering NU1901 through NU1904, which would widen the exemption to
         every future advisory rather than the one being triaged. -->

    <!-- Both default to $(TreatWarningsAsErrors) when unset (Microsoft.NETCore.Native.targets,
         Microsoft.NET.ILLink.targets), so the line above would otherwise also hand ILC its
         warnaserror flag and the trimmer TreatWarningsAsErrors during a Native AOT publish.
         scripts/verify-aot-il-warnings.sh is the designed enforcement for that closure:
         its ALLOWED list tolerates real third-party ILC warnings (EF Core, Serilog, etc.) that
         a blanket warnaserror flag cannot distinguish from a first-party one, and would turn
         into a hard publish failure instead of the nuanced pass this script already makes.
         (No literal double hyphen above: an XML comment may not contain one.) -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>

    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>

    <!-- The one place a version is written. It is stamped into every assembly and it is what the
         release workflow reads when an operator dispatches it with no version input, so the release
         and the binaries cannot disagree. No push cuts a build: CI runs the gates on a pull request
         or a manual dispatch and calls nothing at the end.

         Two shapes. A bare channel - 0.1.0-beta - means "cut the next beta": the release workflow
         finds the highest v0.1.0-beta.N already released, including unpublished drafts, and cuts N+1. Changing 0.1.0
         restarts that count, because it counts per base version. A fully written version -
         0.1.0-beta.12, or 0.1.0 for a real release - is used exactly as written. So editing this
         line and pushing is how you name a version by hand; leaving it alone is how the beta stream
         numbers itself. -->
    <Version>0.1.0-beta</Version>

  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.8" />

  </ItemGroup>

  <!-- Every Native AOT link in this repository, not only the shipping CLI's. Homebrew's dotnet ships
       nonportable.txt, so ILC links keg-only openssl and brotli by name on macOS and the default
       clang search path does not contain either; and Apple's ld-prime asserts on a large Native AOT
       object file (dotnet/runtime#119380), which is why the link is pointed at LLVM's lld when it is
       installed. The CLI carried these alone, so a second AOT publish - the runtime-regex smoke
       executable that scripts/verify-aot-il-warnings.sh publishes beside it - failed to link with
       "library 'ssl' not found" and took the whole IL gate down with it on any Homebrew-dotnet macOS
       host. Living here rather than in each project means a third AOT project cannot reintroduce that
       by being written without them.

       Inert everywhere else: LinkerArg is read only by the native link step, so a project that never
       publishes AOT never sees these, and each entry is guarded on the path actually existing. -->

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <LinkerArg Condition="Exists('/opt/homebrew/opt/openssl@3/lib')" Include="-L/opt/homebrew/opt/openssl@3/lib" />

    <LinkerArg Condition="Exists('/opt/homebrew/opt/brotli/lib')" Include="-L/opt/homebrew/opt/brotli/lib" />

    <LinkerArg Condition="Exists('/usr/local/opt/openssl@3/lib')" Include="-L/usr/local/opt/openssl@3/lib" />

    <LinkerArg Condition="Exists('/usr/local/opt/brotli/lib')" Include="-L/usr/local/opt/brotli/lib" />

    <LinkerArg Condition="Exists('/opt/homebrew/opt/lld/bin/ld64.lld')" Include="--ld-path=/opt/homebrew/opt/lld/bin/ld64.lld" />

    <LinkerArg Condition="!Exists('/opt/homebrew/opt/lld/bin/ld64.lld') and Exists('/usr/local/opt/lld/bin/ld64.lld')" Include="--ld-path=/usr/local/opt/lld/bin/ld64.lld" />

  </ItemGroup>

</Project>
