<Project>

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <LangVersion>latest</LangVersion>

    <!-- The one place a version is written. It is stamped into every assembly, and it is what CI
         reads when it cuts a build after a push to main, so the release and the binaries cannot
         disagree.

         Two shapes. A bare channel - 0.1.0-beta - means "cut the next beta": CI finds the highest
         v0.1.0-beta.N already released, including unpublished drafts, and cuts N+1. Changing 0.1.0
         restarts that count, because it counts per base version. A fully written version -
         0.1.0-beta.12, or 0.1.0 for a real release - is used exactly as written. So editing this
         line and pushing is how you name a version by hand; leaving it alone is how the beta stream
         numbers itself. -->
    <Version>0.1.0-beta</Version>

  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.8" />

  </ItemGroup>

</Project>
