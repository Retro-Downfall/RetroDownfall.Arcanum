<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <IsAotCompatible>true</IsAotCompatible>

    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <!-- API contains no EF query execution path. Keep the experimental publish-time query compiler
         disabled; the Infrastructure compiled model owns tracked state. -->
    <EFOptimizeContext>false</EFOptimizeContext>

  </PropertyGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.PromptCache.Benchmarks" />

  </ItemGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />

    <!-- Keep the direct OpenAPI schema surface aligned with ASP.NET Core OpenAPI's required
         [3.11.0, 4.0.0) dependency range and its patched circular-reference handling. -->
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />

    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />

    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />

    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />

    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />

    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />

    <PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview2" />

    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />

  </ItemGroup>

</Project>
