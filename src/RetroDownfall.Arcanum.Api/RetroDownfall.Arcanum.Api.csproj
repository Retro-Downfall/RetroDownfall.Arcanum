<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <IsAotCompatible>true</IsAotCompatible>

    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <EFOptimizeContext>false</EFOptimizeContext>

  </PropertyGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

  </ItemGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />

    <!-- Pins the transitive Microsoft.OpenApi dependency (2.0.0, pulled in by Microsoft.AspNetCore.OpenApi
         10.0.10) past GHSA-v5pm-xwqc-g5wc (circular schema references can terminate the process); patched in
         2.7.5+. Remove once Microsoft.AspNetCore.OpenApi itself references a patched version. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />

    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />

    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />

    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />

    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.1" />

    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.1" />

    <PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview2" />

    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

</Project>
