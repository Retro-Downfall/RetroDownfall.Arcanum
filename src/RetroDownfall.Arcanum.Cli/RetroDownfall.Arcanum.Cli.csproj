<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <ApplicationIcon>Assets/arcanum.ico</ApplicationIcon>

    <IsAotCompatible>true</IsAotCompatible>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <InvariantGlobalization>true</InvariantGlobalization>

    <EFOptimizeContext>false</EFOptimizeContext>

  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">

    <!-- Every RID-qualified Arcanum publish is the shipping product and therefore Native AOT.
         There is no managed or ReadyToRun fallback. The validation targets below also reject a
         command-line attempt to turn this off. -->
    <PublishAot>true</PublishAot>

    <SelfContained>true</SelfContained>

    <PublishSingleFile>false</PublishSingleFile>

  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' == 'true'">

    <OptimizationPreference>Size</OptimizationPreference>

    <StackTraceSupport>false</StackTraceSupport>

    <DebuggerSupport>false</DebuggerSupport>

    <DebugType>none</DebugType>

    <NativeDebugSymbols>false</NativeDebugSymbols>

    <UseWindowsThreadPool>false</UseWindowsThreadPool>

    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <UseSystemResourceKeys>true</UseSystemResourceKeys>

  </PropertyGroup>

  <!-- EF Core 10 and Serilog publish known dependency-owned diagnostics even when Arcanum's
       compiled model is closed for Native AOT. Keep ordinary shipping output warning-free, but
       never trust this presentation layer as the audit: verify-aot-il-warnings.sh sets
       ArcanumAotDiagnosticAudit=true, re-enables the diagnostics, and rejects every warning not
       attributed to the reviewed dependency allowlist. IL2026 and IL3050 stay unsuppressed here so
       a new incompatible call in Arcanum remains visible in every publish. -->

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' == 'true' and '$(ArcanumAotDiagnosticAudit)' != 'true'">

    <NoWarn>$(NoWarn);IL2104;IL3002;IL3053</NoWarn>

  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx')) and '$(PublishAot)' == 'true'">

    <StripSymbols>true</StripSymbols>

  </PropertyGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' == 'true'">

    <RuntimeHostConfigurationOption
      Include="Microsoft.AspNetCore.Mvc.ApiExplorer.IsEnhancedModelMetadataSupported"
      Value="false"
      Trim="true" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Api\RetroDownfall.Arcanum.Api.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Markdig" Version="1.3.2" />

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />

    <PackageReference Include="Spectre.Console" Version="0.57.2" />

    <PackageReference Include="Terminal.Gui" Version="2.4.17" />

    <PackageReference Include="System.CommandLine" Version="2.0.10" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

  <Target
    Name="RequireArcanumShippingNativeAot"
    BeforeTargets="PrepareForPublish"
    Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' != 'true'">
    <Error
      Code="ARC0001"
      Text="Every RID-qualified Arcanum publish must use Native AOT. PublishAot cannot be disabled for a shipping build." />
  </Target>

</Project>
