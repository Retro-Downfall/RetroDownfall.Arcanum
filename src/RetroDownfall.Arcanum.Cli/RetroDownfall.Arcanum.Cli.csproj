<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <PublishAot>true</PublishAot>

    <IsAotCompatible>true</IsAotCompatible>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <InvariantGlobalization>true</InvariantGlobalization>

    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>

    <EFOptimizeContext>false</EFOptimizeContext>

  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">

    <!-- Apple ld64/clang .pcm notices on stderr are surfaced as MSBuild EXEC warnings during ilc; not IL diagnostics. -->

    <StripSymbols>false</StripSymbols>

  </PropertyGroup>

  <!-- Homebrew dotnet ships nonportable.txt, so Native AOT links keg-only openssl/brotli on macOS. Add search paths when present. -->

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <LinkerArg Condition="Exists('/opt/homebrew/opt/openssl@3/lib')" Include="-L/opt/homebrew/opt/openssl@3/lib" />

    <LinkerArg Condition="Exists('/opt/homebrew/opt/brotli/lib')" Include="-L/opt/homebrew/opt/brotli/lib" />

    <LinkerArg Condition="Exists('/usr/local/opt/openssl@3/lib')" Include="-L/usr/local/opt/openssl@3/lib" />

    <LinkerArg Condition="Exists('/usr/local/opt/brotli/lib')" Include="-L/usr/local/opt/brotli/lib" />

  </ItemGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Api\RetroDownfall.Arcanum.Api.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Markdig" Version="1.2.0" />

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.8" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />

    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />

  </ItemGroup>

  <ItemGroup>

    <TrimmerRootAssembly Include="Spectre.Console.Cli" />

  </ItemGroup>

</Project>
