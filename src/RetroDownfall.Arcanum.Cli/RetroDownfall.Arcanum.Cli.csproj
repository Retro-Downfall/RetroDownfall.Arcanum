<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <PublishAot>true</PublishAot>

    <IsAotCompatible>true</IsAotCompatible>

    <EFOptimizeContext>false</EFOptimizeContext>

  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">

    <!-- Apple ld64/clang .pcm notices on stderr are surfaced as MSBuild EXEC warnings during ilc; not IL diagnostics. -->

    <StripSymbols>false</StripSymbols>

  </PropertyGroup>

  <!-- ILC-only: grouped third-party diagnostics (IL2104/IL3053) and cross-assembly IL3002/IL3000/IL2026 have no valid UnconditionalSuppressMessage target in first-party code; IlcArg scopes suppression to the native compile step only (not Roslyn <NoWarn>). -->

  <ItemGroup>

    <IlcArg Include="--nowarn:IL2104,IL3053,IL3002,IL3000,IL2026" />

  </ItemGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Api\RetroDownfall.Arcanum.Api.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Markdig" Version="1.1.3" />

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.7" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.7" />

    <PackageReference Include="Spectre.Console.Cli" Version="0.53.0" />

  </ItemGroup>

  <ItemGroup>

    <TrimmerRootAssembly Include="Spectre.Console.Cli" />

  </ItemGroup>

</Project>
