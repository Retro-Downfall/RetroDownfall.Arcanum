<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <IsAotCompatible>true</IsAotCompatible>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <InvariantGlobalization>true</InvariantGlobalization>

    <EFOptimizeContext>false</EFOptimizeContext>

  </PropertyGroup>

  <PropertyGroup>

    <!-- Native AOT for Linux/Windows publish only. Do not enable on empty RID
         (plain `dotnet build` / `dotnet run`) — that stamps
         RuntimeFeature.IsDynamicCodeSupported=false into runtimeconfig and breaks
         EF Core LINQ (queries are not precompiled; see EFPrecompileQueriesStage=none). -->
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('osx'))">true</PublishAot>

    <!-- macOS 27 / Xcode 26+ ld-prime crashes on large Native AOT object files with
         "Assertion failed: (_addend == uniqueIndex &amp;&amp; 'too many large addends')"
         (dotnet/runtime#119380). The runtime fix is not yet in .NET 10.0.10, and
         ld_classic is no longer supported. On the current toolchain, single-file
         app hosts are also launched as broken executables. Fall back to a
         folder-based self-contained publish on macOS so the installed CLI actually
         runs. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">false</PublishSingleFile>

    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">false</PublishTrimmed>

  </PropertyGroup>

  <PropertyGroup>

    <!-- Keep the Native AOT object file small where AOT is still used. -->
    <OptimizationPreference>Size</OptimizationPreference>

    <StackTraceSupport>false</StackTraceSupport>

    <DebuggerSupport>false</DebuggerSupport>

    <UseWindowsThreadPool>false</UseWindowsThreadPool>

    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <UseSystemResourceKeys>true</UseSystemResourceKeys>

  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">

    <!-- Apple ld64/clang .pcm notices on stderr are surfaced as MSBuild EXEC warnings during ilc; not IL diagnostics. -->

    <StripSymbols>false</StripSymbols>

  </PropertyGroup>

  <!-- Homebrew dotnet ships nonportable.txt, so Native AOT links keg-only openssl/brotli on macOS. Add search paths when present. -->

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <LinkerArg Condition="Exists('/opt/homebrew/opt/openssl@3/lib')" Include="-L/opt/homebrew/opt/openssl@3/lib" />

    <LinkerArg Condition="Exists('/opt/homebrew/opt/brotli/lib')" Include="-L/opt/homebrew/opt/brotli/lib" />

    <LinkerArg Condition="Exists('/usr/local/opt/openssl@3/lib')" Include="-L/usr/local/opt/openssl@3/lib" />

    <LinkerArg Condition="Exists('/usr/local/opt/brotli/lib')" Include="-L/usr/local/opt/brotli/lib" />

  </ItemGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Api\RetroDownfall.Arcanum.Api.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Markdig" Version="1.3.2" />

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.8" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />

    <PackageReference Include="Spectre.Console" Version="0.57.2" />

    <PackageReference Include="Terminal.Gui" Version="2.4.17" />

    <PackageReference Include="ConsoleAppFramework" Version="5.7.13">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>

    </PackageReference>

    <!-- Provides public ConsoleAppContext/ConsoleAppFilter types (the per-project source
         generator otherwise emits them as internal), since AskCommand.Ask needs
         ConsoleAppContext as a public method parameter to read EscapedArguments. -->
    <PackageReference Include="ConsoleAppFramework.Abstractions" Version="5.7.13" />

  </ItemGroup>

</Project>
