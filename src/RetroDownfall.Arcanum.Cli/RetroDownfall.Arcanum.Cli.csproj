<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <ApplicationIcon>Assets/arcanum.ico</ApplicationIcon>

    <IsAotCompatible>true</IsAotCompatible>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <InvariantGlobalization>true</InvariantGlobalization>

    <EFOptimizeContext>false</EFOptimizeContext>

  </PropertyGroup>

  <PropertyGroup>

    <!-- macOS 27 / Xcode 26+ ld-prime asserts on large Native AOT object files:
         "Assertion failed: (_addend == uniqueIndex &amp;&amp; 'too many large addends')"
         (dotnet/runtime#119380). ILC itself is fine — it emits the object file, and the failure is
         entirely in Apple's linker, which ld_classic no longer exists to work around. LLVM's lld
         does not have the bug, so macOS gets Native AOT whenever ld64.lld is installed and falls
         back to a folder-based self-contained publish when it is not. See the ld-path LinkerArg
         below; `brew install lld`. Shrinking the object does not avoid it: stripping debug info and
         every size switch took it from 636 MB to 452 MB and it still asserted. -->
    <_AppleLldPath Condition="Exists('/opt/homebrew/opt/lld/bin/ld64.lld')">/opt/homebrew/opt/lld/bin/ld64.lld</_AppleLldPath>

    <_AppleLldPath Condition="'$(_AppleLldPath)' == '' and Exists('/usr/local/opt/lld/bin/ld64.lld')">/usr/local/opt/lld/bin/ld64.lld</_AppleLldPath>

    <_TargetsApple Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">true</_TargetsApple>

    <!-- Do not enable on an empty RID (plain `dotnet build` / `dotnet run`) — that stamps
         RuntimeFeature.IsDynamicCodeSupported=false into runtimeconfig and breaks EF Core LINQ
         (queries are not precompiled; see EFPrecompileQueriesStage=none). -->
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' and '$(_TargetsApple)' != 'true'">true</PublishAot>

    <PublishAot Condition="'$(RuntimeIdentifier)' != '' and '$(_TargetsApple)' == 'true' and '$(_AppleLldPath)' != ''">true</PublishAot>

    <!-- Native AOT is inherently a single native image, so PublishSingleFile is meaningless there.
         It stays off on the macOS fallback because the current toolchain produces single-file app
         hosts that launch as broken executables. -->
    <PublishSingleFile Condition="'$(_TargetsApple)' == 'true'">false</PublishSingleFile>

    <PublishTrimmed Condition="'$(_TargetsApple)' == 'true' and '$(PublishAot)' != 'true'">false</PublishTrimmed>

  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' == 'true'">

    <!-- Keep the Native AOT object file small. Gated on PublishAot rather than on a RID list,
         because the SDK emits every one of these as a runtimeconfig configProperty on the sole
         condition that the property is set: an unguarded group also reaches plain `dotnet build` /
         `dotnet run` and any untrimmed publish, where UseSystemResourceKeys=true has no trimmer to
         justify it and simply degrades every BCL exception message to a bare resource key
         ("Arg_NullReferenceException"). RuntimeIdentifier is named explicitly alongside PublishAot
         even though PublishAot is only ever set with a RID: an explicit `-p:PublishAot=true` on a
         RID-less build would otherwise reopen exactly that hole, and HostProjectFeatureSwitchTests
         checks for the guard syntactically rather than trusting the transitive argument. -->
    <OptimizationPreference>Size</OptimizationPreference>

    <StackTraceSupport>false</StackTraceSupport>

    <DebuggerSupport>false</DebuggerSupport>

    <UseWindowsThreadPool>false</UseWindowsThreadPool>

    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <UseSystemResourceKeys>true</UseSystemResourceKeys>

  </PropertyGroup>

  <PropertyGroup Condition="'$(_TargetsApple)' == 'true'">

    <!-- Apple ld64/clang .pcm notices on stderr are surfaced as MSBuild EXEC warnings during ilc;
         not IL diagnostics. Symbols are kept on the non-AOT fallback, where the publish is a plain
         managed folder and they cost little. An AOT image carries its own DWARF, and keeping it
         quadruples the binary (477 MB against 103 MB), so the AOT path strips. -->
    <StripSymbols Condition="'$(PublishAot)' != 'true'">false</StripSymbols>

    <StripSymbols Condition="'$(PublishAot)' == 'true'">true</StripSymbols>

  </PropertyGroup>

  <!-- The macOS keg-only openssl/brotli search paths and the lld ld-path these links need now live in
       Directory.Build.props, so every Native AOT publish in the repository gets them rather than only
       this one. -->

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Api\RetroDownfall.Arcanum.Api.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Markdig" Version="1.3.2" />

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />

    <PackageReference Include="Spectre.Console" Version="0.57.2" />

    <PackageReference Include="Terminal.Gui" Version="2.4.17" />

    <PackageReference Include="System.CommandLine" Version="2.0.10" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

</Project>
