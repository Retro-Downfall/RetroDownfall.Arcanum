<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Delivers the hermetic SQLCipher library for the RID being built and embeds its provenance
    manifest. Importing the asset project's target rather than referencing the project keeps the
    dependency to what it actually is: files, not an assembly.
  -->
  <Import Project="../RetroDownfall.Arcanum.NativeSqlCipher/build/RetroDownfall.Arcanum.NativeSqlCipher.targets" />

  <PropertyGroup>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RootNamespace>RetroDownfall.Arcanum.Infrastructure</RootNamespace>

    <AssemblyName>RetroDownfall.Arcanum.Infrastructure</AssemblyName>

    <IsAotCompatible>true</IsAotCompatible>

    <IsTrimmable>true</IsTrimmable>

    <!-- PublishAot belongs on the executable host at publish time, not on this library.
         Leaving it true here stamped AOT feature switches into local Debug hosts and
         broke EF LINQ (no precompiled queries). -->
    <PublishAot>false</PublishAot>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <!-- Keep false: MSBuild precompiled-query pass fails on some LINQ (e.g. ordered Include); compiled model comes from `dotnet ef dbcontext optimize`. -->

    <EFOptimizeContext>false</EFOptimizeContext>

    <EFPrecompileQueriesStage>none</EFPrecompileQueriesStage>

  </PropertyGroup>

  <ItemGroup>

    <!-- SDK-style schema project conventions: the declarative one-object-per-file tree is included
         by glob, so adding a table/trigger/FTS/view object is adding a file. Never a hand-maintained
         list, and never a filesystem read at install time. -->
    <EmbeddedResource Include="Data\Schema\**\*.sql" />

  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Api" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Api.DevHost" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Cli" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.RegexAotSmoke" />

    <!-- The benchmark host composes the same internal services a live host does. Measuring a public
         facade instead would measure a facade, and rebuilding the composition against copies would
         make the gate a test of the copies. -->
    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Covenant.Benchmarks" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Secrets\RetroDownfall.Arcanum.Secrets.csproj" />

  </ItemGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

    </PackageReference>

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />

    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />

    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />

    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!--
      The managed provider only. The native library comes from RetroDownfall.Arcanum.NativeSqlCipher,
      which ships one verified, reproducibly built SQLCipher per RID; a bundle package would deliver
      binaries Arcanum neither builds nor verifies.
    -->
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlcipher" Version="2.1.11" />

    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.1" />

    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.1" />

    <PackageReference Include="A2A" Version="1.0.0-preview2" />

    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

</Project>
