<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RootNamespace>RetroDownfall.Arcanum.Infrastructure</RootNamespace>

    <AssemblyName>RetroDownfall.Arcanum.Infrastructure</AssemblyName>

    <IsAotCompatible>true</IsAotCompatible>

    <IsTrimmable>true</IsTrimmable>

    <PublishAot>true</PublishAot>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <!-- Keep false: MSBuild precompiled-query pass fails on some LINQ (e.g. ordered Include); compiled model comes from `dotnet ef dbcontext optimize`. -->

    <EFOptimizeContext>false</EFOptimizeContext>

    <EFPrecompileQueriesStage>none</EFPrecompileQueriesStage>

  </PropertyGroup>

  <ItemGroup>

    <EmbeddedResource Include="Data\SqlMigrations\*.sql" />

  </ItemGroup>

  <ItemGroup>

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Tests" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Api" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Api.DevHost" />

    <InternalsVisibleTo Include="RetroDownfall.Arcanum.Cli" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

    <ProjectReference Include="..\RetroDownfall.Arcanum.Secrets\RetroDownfall.Arcanum.Secrets.csproj" />

  </ItemGroup>

  <ItemGroup>

    <FrameworkReference Include="Microsoft.AspNetCore.App" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.8" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" Version="10.0.8" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

    </PackageReference>

    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.8" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />

    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />

    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />

    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />

    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />

    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />

    <PackageReference Include="A2A" Version="1.0.0-preview2" />

  </ItemGroup>

</Project>
