<?xml version="1.0" encoding="utf-8" ?>

<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:RetroDownfall.Compendium.Ux.Converters"
             x:Class="RetroDownfall.Compendium.Ux.App">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />

                <ResourceDictionary Source="Resources/Styles/Sizes.xaml" />

                <ResourceDictionary Source="Resources/Styles/CompendiumTheme.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <conv:EnumToStringConverter x:Key="EnumToStringConverter" />

            <conv:HexToColorConverter x:Key="HexToColorConverter" />

        </ResourceDictionary>

    </Application.Resources>

</Application>
