<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Accent -->

  <Color x:Key="LightAccent">#00f584</Color>

  <Color x:Key="DarkAccent">#00d878</Color>

  <!-- On Accent -->

  <Color x:Key="LightOnAccent">#212121</Color>

  <Color x:Key="DarkOnAccent">#212121</Color>

  <!-- Surfaces -->

  <Color x:Key="LightSurface">#ffffff</Color>

  <Color x:Key="DarkSurface">#212121</Color>

  <!-- Panel / elevated surfaces -->

  <Color x:Key="LightPanel">#f5f6f7</Color>

  <Color x:Key="DarkPanel">#2b2b2b</Color>

  <!-- Text on surfaces -->

  <Color x:Key="LightOnSurface">#212121</Color>

  <Color x:Key="DarkOnSurface">#f5f6f7</Color>

  <!-- Muted text -->

  <Color x:Key="LightMuted">#6e6e6e</Color>

  <Color x:Key="DarkMuted">#a0a0a0</Color>

  <!-- Borders -->

  <Color x:Key="LightBorder">#dfe1e3</Color>

  <Color x:Key="DarkBorder">#3a3a3a</Color>

  <!-- Validation -->

  <Color x:Key="LightDanger">#d32f2f</Color>

  <Color x:Key="DarkDanger">#ef5350</Color>

  <Color x:Key="LightWarning">#f9a825</Color>

  <Color x:Key="DarkWarning">#ffca28</Color>

  <Color x:Key="LightSuccess">#2e7d32</Color>

  <Color x:Key="DarkSuccess">#66bb6a</Color>

</ResourceDictionary>
