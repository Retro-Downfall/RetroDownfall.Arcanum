<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFrameworks>net10.0;net10.0-maccatalyst</TargetFrameworks>

    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>

    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>

    <UseMaui Condition="'$(TargetFramework)' != 'net10.0'">true</UseMaui>

    <SingleProject Condition="'$(TargetFramework)' != 'net10.0'">true</SingleProject>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <LangVersion>latest</LangVersion>

    <RootNamespace>RetroDownfall.Compendium.Ux</RootNamespace>

    <AssemblyName>RetroDownfall.Compendium.Ux</AssemblyName>

    <ApplicationTitle>Compendium</ApplicationTitle>

    <ApplicationId>com.retrodownfall.compendium</ApplicationId>

    <ApplicationVersion>1</ApplicationVersion>

    <ApplicationDisplayVersion>0.1.0-beta</ApplicationDisplayVersion>

  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />

    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />

  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\RetroDownfall.Arcanum.Core\RetroDownfall.Arcanum.Core.csproj" />

  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">

    <MauiIcon Include="Resources\Images\appicon.svg" ForegroundFile="Resources\Images\appiconfg.svg" Color="#212121" />

    <MauiSplashScreen Include="Resources\Images\appicon.svg" Color="#212121" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*" />

  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">

    <Compile Remove="App.xaml.cs" />

    <Compile Remove="MauiProgram.cs" />

    <Compile Remove="Views\**\*.xaml.cs" />

    <EmbeddedResource Remove="App.xaml" />

    <EmbeddedResource Remove="Views\**\*.xaml" />

    <EmbeddedResource Remove="Resources\Styles\*.xaml" />

    <MauiCss Remove="Resources\Styles\*.xaml" />

  </ItemGroup>

  <PropertyGroup>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>

    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>

  </PropertyGroup>

</Project>
