<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="clr-namespace:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.AppShell"
             Title="Compendium">

    <Grid ColumnDefinitions="240,*"
          RowDefinitions="*,Auto">

        <Border Grid.Row="0"
                Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightPanel}, Dark={StaticResource DarkPanel}}"
                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}">

            <CollectionView x:Name="NavCollection"
                            ItemsSource="{Binding Sections}"
                            SelectionMode="Single"
                            SelectionChangedCommand="{Binding SelectSectionCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Grid Padding="16,12"
                              ColumnDefinitions="Auto,*">

                            <Label Grid.Column="0"
                                   Text="{Binding Glyph}"
                                   FontSize="18"
                                   WidthRequest="28"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2">

                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding Subtitle}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" />

                            </VerticalStackLayout>

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Border>

        <ContentView x:Name="ContentHost"
                     Grid.Row="0"
                     Grid.Column="1" />

        <controls:SaveBar Grid.Row="1"
                          Grid.ColumnSpan="2"
                          IsDirty="{Binding IsDirty}"
                          IsSaving="{Binding IsSaving}"
                          StatusMessage="{Binding StatusMessage}"
                          LastSavedAt="{Binding LastSavedAt}"
                          HasExternalChange="{Binding HasExternalChange}"
                          SaveCommand="{Binding SaveCommand}"
                          RefreshCommand="{Binding RefreshCommand}" />

    </Grid>

</ContentPage>
