<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.CliPage"
             x:DataType="vm:ConfigurationViewModel">

  <ScrollViewer>
    <StackPanel Margin="24"
                Spacing="16">

      <TextBlock Text="CLI"
                 FontSize="{DynamicResource ForgePageTitleFontSize}"
                 FontWeight="SemiBold" />

      <controls:LabeledPicker Label="Theme"
                              Description="CLI color theme. Built-in themes replace per-color implementation overrides."
                              PickerTitle="Select theme"
                              Key="cli.theme"
                              ValidationErrors="{Binding ValidationErrorsByPointer}"
                              ItemsSource="{Binding CliThemes}"
                              SelectedItem="{Binding Cli.Theme, Mode=TwoWay}" />

      <controls:LabeledToggle Label="Show mana bar"
                              Description="Show the persistent token-budget indicator in chat."
                              IsOn="{Binding Cli.ShowManaBar, Mode=TwoWay}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
