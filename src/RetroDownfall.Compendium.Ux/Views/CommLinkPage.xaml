<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.CommLinkPage"
             Title="Comm Link">

    <ScrollView>

        <VerticalStackLayout Padding="24"
                             Spacing="16">

            <Label Text="Comm Link"
                   FontSize="24"
                   FontAttributes="Bold" />

            <controls:LabeledEntry Label="Webhook URL"
                                   Description="Outbound URL POSTed to on Comm Link alerts. Defaults to https; add http to AllowedSchemes to use plaintext."
                                   Key="commLink.webhookUrl"
                                   ValidationErrors="{Binding ValidationErrorsByPointer}"
                                   Text="{Binding CommLink.WebhookUrl, Mode=TwoWay}"
                                   Placeholder="https://hooks.example.com/arcanum" />

            <controls:LabeledStepper Label="Webhook timeout (s)"
                                     Description="Timeout for the named HttpClient(CommLinkWebhook) used to POST alerts."
                                     Key="commLink.webhookTimeoutSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding CommLink.WebhookTimeoutSeconds, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="120"
                                     Increment="1" />

            <controls:ChipsEditor Label="Allowed schemes"
                                  Description="URI schemes the webhook dispatcher is permitted to call. Default [https]. Add http to opt in to plaintext."
                                  Text="{Binding CommLink.AllowedSchemes, Mode=TwoWay}" />

            <controls:ChipsEditor Label="Allowed hosts"
                                  Description="Optional allowed webhook hosts (e.g. hooks.example.com). When populated, any URL whose host is not listed is rejected at startup."
                                  Text="{Binding CommLink.AllowedHosts, Mode=TwoWay}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
