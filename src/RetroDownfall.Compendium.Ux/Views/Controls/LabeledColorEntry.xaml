<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:conv="clr-namespace:RetroDownfall.Compendium.Ux.Converters"
             x:Class="RetroDownfall.Compendium.Ux.Views.Controls.LabeledColorEntry">

    <VerticalStackLayout Spacing="4">

        <Label x:Name="LabelControl"
               FontAttributes="Bold" />

        <HorizontalStackLayout Spacing="8">

            <Entry x:Name="EntryControl"
                   Text="{Binding Text, Source={RelativeSource AncestorType={x:Type local:LabeledColorEntry}}, Mode=TwoWay}"
                   Placeholder="{Binding Placeholder, Source={RelativeSource AncestorType={x:Type local:LabeledColorEntry}}}"
                   HorizontalOptions="FillAndExpand" />

            <Border x:Name="SwatchBorder"
                    WidthRequest="36"
                    HeightRequest="36"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                    StrokeShape="RoundRectangle 6"
                    Padding="0">

                <BoxView x:Name="Swatch"
                         BackgroundColor="{Binding Text, Source={RelativeSource AncestorType={x:Type local:LabeledColorEntry}}, Converter={StaticResource HexToColorConverter}}" />

            </Border>

        </HorizontalStackLayout>

        <Label x:Name="DescriptionControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />

        <Label x:Name="HintControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightDanger}, Dark={StaticResource DarkDanger}}"
               Text="{Binding ValidationMessage, Source={RelativeSource AncestorType={x:Type local:LabeledColorEntry}}}" />

    </VerticalStackLayout>

</ContentView>
