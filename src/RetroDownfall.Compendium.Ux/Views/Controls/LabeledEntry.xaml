<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.Controls.LabeledEntry">

    <VerticalStackLayout Spacing="4">

        <Label x:Name="LabelControl"
               FontAttributes="Bold" />

        <Entry x:Name="EntryControl"
               Text="{Binding Text, Source={RelativeSource AncestorType={x:Type local:LabeledEntry}}, Mode=TwoWay}"
               Placeholder="{Binding Placeholder, Source={RelativeSource AncestorType={x:Type local:LabeledEntry}}}"
               IsPassword="{Binding IsPassword, Source={RelativeSource AncestorType={x:Type local:LabeledEntry}}}" />

        <Label x:Name="DescriptionControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />

        <Label x:Name="HintControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightDanger}, Dark={StaticResource DarkDanger}}"
               Text="{Binding ValidationMessage, Source={RelativeSource AncestorType={x:Type local:LabeledEntry}}}" />

    </VerticalStackLayout>

</ContentView>
