<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:conv="using:RetroDownfall.Compendium.Ux.Converters"
             x:Class="RetroDownfall.Compendium.Ux.Views.Controls.LabeledPicker"
             x:Name="Root">

    <UserControl.Resources>

        <conv:EnumToStringConverter x:Key="EnumToStringConverter" />

    </UserControl.Resources>

    <StackPanel Spacing="4">

        <TextBlock Text="{Binding #Root.Label}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ForgeTextBrush}" />

        <ComboBox ItemsSource="{Binding #Root.ItemsSource}"
                  SelectedItem="{Binding #Root.SelectedItem, Mode=TwoWay}"
                  PlaceholderText="{Binding #Root.PickerTitle}">

            <ComboBox.ItemTemplate>

                <DataTemplate>

                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToStringConverter}}" />

                </DataTemplate>

            </ComboBox.ItemTemplate>

        </ComboBox>

        <TextBlock Text="{Binding #Root.Description}"
                   FontSize="{DynamicResource ForgeUiSecondaryFontSize}"
                   Foreground="{DynamicResource ForgeMutedTextBrush}"
                   IsVisible="{Binding #Root.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="{Binding #Root.ValidationMessage}"
                   FontSize="{DynamicResource ForgeUiSecondaryFontSize}"
                   Foreground="{DynamicResource ForgeErrorBrush}"
                   IsVisible="{Binding #Root.ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    </StackPanel>

</UserControl>
