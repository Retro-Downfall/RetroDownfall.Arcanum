<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:conv="clr-namespace:RetroDownfall.Compendium.Ux.Converters"
             x:Class="RetroDownfall.Compendium.Ux.Views.Controls.LabeledPicker">

    <VerticalStackLayout Spacing="4">

        <Label x:Name="LabelControl"
               FontAttributes="Bold" />

        <Picker x:Name="PickerControl"
                Title="{Binding PickerTitle, Source={RelativeSource AncestorType={x:Type local:LabeledPicker}}}"
                ItemsSource="{Binding ItemsSource, Source={RelativeSource AncestorType={x:Type local:LabeledPicker}}}"
                SelectedItem="{Binding SelectedItem, Source={RelativeSource AncestorType={x:Type local:LabeledPicker}}, Mode=TwoWay}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumToStringConverter}}" />

        <Label x:Name="DescriptionControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />

        <Label x:Name="HintControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightDanger}, Dark={StaticResource DarkDanger}}"
               Text="{Binding ValidationMessage, Source={RelativeSource AncestorType={x:Type local:LabeledPicker}}}" />

    </VerticalStackLayout>

</ContentView>
