<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.Controls.LabeledStepper">

    <VerticalStackLayout Spacing="4">

        <Label x:Name="LabelControl"
               FontAttributes="Bold" />

        <HorizontalStackLayout Spacing="8">

            <Stepper x:Name="StepperControl"
                     Value="{Binding Value, Source={RelativeSource AncestorType={x:Type local:LabeledStepper}}, Mode=TwoWay}"
                     Minimum="{Binding Minimum, Source={RelativeSource AncestorType={x:Type local:LabeledStepper}}}"
                     Maximum="{Binding Maximum, Source={RelativeSource AncestorType={x:Type local:LabeledStepper}}}"
                     Increment="{Binding Increment, Source={RelativeSource AncestorType={x:Type local:LabeledStepper}}}" />

            <Label x:Name="ValueControl"
                   VerticalOptions="Center" />

        </HorizontalStackLayout>

        <Label x:Name="DescriptionControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />

        <Label x:Name="HintControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightDanger}, Dark={StaticResource DarkDanger}}"
               Text="{Binding ValidationMessage, Source={RelativeSource AncestorType={x:Type local:LabeledStepper}}}" />

    </VerticalStackLayout>

</ContentView>
