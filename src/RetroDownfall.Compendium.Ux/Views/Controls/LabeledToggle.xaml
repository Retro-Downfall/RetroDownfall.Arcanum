<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.Controls.LabeledToggle">

    <VerticalStackLayout Spacing="4">

        <HorizontalStackLayout Spacing="12">

            <Label x:Name="LabelControl"
                   VerticalOptions="Center" />

            <Switch x:Name="SwitchControl"
                    IsToggled="{Binding IsOn, Source={RelativeSource AncestorType={x:Type local:LabeledToggle}}, Mode=TwoWay}" />

        </HorizontalStackLayout>

        <Label x:Name="DescriptionControl"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightMuted}, Dark={StaticResource DarkMuted}}" />

    </VerticalStackLayout>

</ContentView>
