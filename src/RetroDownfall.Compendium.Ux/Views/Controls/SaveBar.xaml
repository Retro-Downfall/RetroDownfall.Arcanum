<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.Controls.SaveBar">

    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
          Padding="12,8"
          BackgroundColor="{AppThemeBinding Light={StaticResource LightPanel}, Dark={StaticResource DarkPanel}}">

        <BoxView Grid.ColumnSpan="5"
                 Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                 HeightRequest="1"
                 VerticalOptions="Start" />

        <Ellipse Grid.Column="0"
                 WidthRequest="10"
                 HeightRequest="10"
                 VerticalOptions="Center"
                 Margin="0,0,8,0"
                 Fill="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"
                 IsVisible="{Binding IsDirty, Source={RelativeSource AncestorType={x:Type local:SaveBar}}}" />

        <Label Grid.Column="1"
               x:Name="StatusLabel"
               VerticalOptions="Center" />

        <Button Grid.Column="2"
                Text="Reload"
                Command="{Binding RefreshCommand, Source={RelativeSource AncestorType={x:Type local:SaveBar}}}"
                IsVisible="{Binding HasExternalChange, Source={RelativeSource AncestorType={x:Type local:SaveBar}}}" />

        <Button Grid.Column="3"
                Text="Cancel"
                Command="{Binding CancelCommand, Source={RelativeSource AncestorType={x:Type local:SaveBar}}}"
                IsVisible="{Binding IsDirty, Source={RelativeSource AncestorType={x:Type local:SaveBar}}}" />

        <Button Grid.Column="4"
                Text="Save"
                Command="{Binding SaveCommand, Source={RelativeSource AncestorType={x:Type local:SaveBar}}}"
                IsEnabled="{Binding IsDirty, Source={RelativeSource AncestorType={x:Type local:SaveBar}}}" />

    </Grid>

</ContentView>
