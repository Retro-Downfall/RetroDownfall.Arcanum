<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.DaemonPage"
             x:DataType="vm:ConfigurationViewModel">

  <ScrollViewer>
    <StackPanel Margin="24"
                Spacing="16">

      <TextBlock Text="Daemon"
                 FontSize="{DynamicResource ForgePageTitleFontSize}"
                 FontWeight="SemiBold" />

      <controls:LabeledStepper Label="Concurrent jobs"
                               Description="Maximum Unseen Servant jobs that may run simultaneously."
                               Key="daemon.maxConcurrentJobs"
                               ValidationErrors="{Binding ValidationErrorsByPointer}"
                               Value="{Binding Daemon.MaxConcurrentJobs, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="1024"
                               Increment="1" />

      <Button Content="Add Job"
              HorizontalAlignment="Left"
              Command="{Binding Daemon.AddJobCommand}" />

      <ItemsControl ItemsSource="{Binding Daemon.Jobs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DaemonSectionViewModel+UnseenServantJobViewModel">
            <Border BorderBrush="{DynamicResource ForgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,8"
                    Padding="12">
              <StackPanel Spacing="8">

                <controls:LabeledEntry Label="Name"
                                       Description="Human-readable schedule name."
                                       Text="{Binding Name, Mode=TwoWay}" />

                <controls:LabeledStepper Label="Interval (minutes)"
                                         Description="Minutes between scheduled runs."
                                         Value="{Binding IntervalMinutes, Mode=TwoWay}"
                                         Minimum="1"
                                         Maximum="10080"
                                         Increment="1" />

                <controls:LabeledEntry Label="Target spell"
                                       Description="Spell invoked on each schedule tick."
                                       Text="{Binding TargetSpell, Mode=TwoWay}"
                                       Placeholder="lore-sweep" />

                <controls:LabeledToggle Label="Enabled"
                                        Description="Make this schedule eligible to run."
                                        IsOn="{Binding Enabled, Mode=TwoWay}" />

                <Button Content="Remove"
                        HorizontalAlignment="Left"
                        Command="{Binding $parent[UserControl].((vm:ConfigurationViewModel)DataContext).Daemon.RemoveJobCommand}"
                        CommandParameter="{Binding .}" />

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
