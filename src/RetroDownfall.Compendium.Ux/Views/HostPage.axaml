<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.HostPage"
             x:DataType="vm:ConfigurationViewModel">

  <ScrollViewer>
    <StackPanel Margin="24"
                Spacing="16">

      <TextBlock Text="Host"
                 FontSize="{DynamicResource ForgePageTitleFontSize}"
                 FontWeight="SemiBold" />

      <controls:LabeledStepper Label="Port"
                               Description="Kestrel HTTP listen port."
                               Key="host.port"
                               ValidationErrors="{Binding ValidationErrorsByPointer}"
                               Value="{Binding Host.Port, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="65535"
                               Increment="1" />

      <controls:LabeledToggle Label="Listen on all interfaces"
                              Description="Bind externally using HTTPS-only. External binding also enforces rate limiting and metrics authentication."
                              IsOn="{Binding Host.ListenAny, Mode=TwoWay}" />

      <controls:ChipsEditor Label="CORS allowed origins"
                            Description="Browser origins permitted to read Arcanum responses."
                            Text="{Binding Host.CorsAllowedOrigins, Mode=TwoWay}" />

      <TextBlock Text="Audit policy"
                 FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                 FontWeight="SemiBold" />

      <controls:LabeledToggle Label="Inference audit log"
                              Description="Persist an append-only audit trail for completed inference turns."
                              IsOn="{Binding Host.AuditLogEnabled, Mode=TwoWay}" />

      <controls:LabeledStepper Label="Audit retention (days)"
                               Description="Delete dated inference audit files older than this compliance retention period."
                               Key="host.auditLog.retentionDays"
                               ValidationErrors="{Binding ValidationErrorsByPointer}"
                               Value="{Binding Host.AuditLogRetentionDays, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="365"
                               Increment="1" />

      <controls:LabeledToggle Label="Redact tool arguments"
                              Description="Store tool names without potentially sensitive argument JSON."
                              IsOn="{Binding Host.AuditLogRedactToolArguments, Mode=TwoWay}" />

      <TextBlock Text="HTTPS"
                 FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                 FontWeight="SemiBold" />

      <Border Background="{DynamicResource ForgeSurfaceAltBrush}"
              BorderBrush="{DynamicResource ForgeWarningBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource ForgeMutedTextBrush}"
                   Text="ListenAny / ARCANUM_HOST_ANY requires HTTPS and exposes only the TLS port. The local certificate generator creates loopback SANs and does not install trust; use a correctly trusted certificate for remote access." />
      </Border>

      <controls:LabeledToggle Label="Enable HTTPS"
                              Description="Add the TLS listener; required for all-interface binding."
                              IsOn="{Binding Host.HttpsEnabled, Mode=TwoWay}" />

      <controls:LabeledStepper Label="HTTPS port"
                               Description="TLS listen port. It must differ from the HTTP port."
                               Key="host.https.port"
                               ValidationErrors="{Binding ValidationErrorsByPointer}"
                               Value="{Binding Host.HttpsPort, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="65535"
                               Increment="1" />

      <controls:LabeledEntry Label="Certificate path"
                             Description="PFX bundle path, or PEM certificate path when a private key path is supplied."
                             Key="host.https.certificatePath"
                             ValidationErrors="{Binding ValidationErrorsByPointer}"
                             Text="{Binding Host.HttpsCertificatePath, Mode=TwoWay}"
                             Placeholder="~/.config/arcanum/certs/localhost.pfx" />

      <controls:LabeledEntry Label="Private key path"
                             Description="Optional PEM private key path."
                             Key="host.https.privateKeyPath"
                             ValidationErrors="{Binding ValidationErrorsByPointer}"
                             Text="{Binding Host.HttpsPrivateKeyPath, Mode=TwoWay}"
                             Placeholder="~/.config/arcanum/certs/localhost.key" />

      <controls:LabeledEntry Label="Certificate password environment variable"
                             Description="Exact variable containing the PFX password. Leave blank to use ARCANUM_HTTPS_CERTIFICATE_PASSWORD. Ignored for PEM."
                             Key="host.https.certificatePasswordEnvironmentVariable"
                             ValidationErrors="{Binding ValidationErrorsByPointer}"
                             Text="{Binding Host.HttpsCertificatePasswordEnvironmentVariable, Mode=TwoWay}"
                             Placeholder="ARCANUM_HTTPS_CERTIFICATE_PASSWORD" />

      <Button Content="Generate local certificate"
              HorizontalAlignment="Left"
              Command="{Binding Host.GenerateLocalCertificateCommand}" />

      <TextBlock Text="Observability"
                 FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                 FontWeight="SemiBold" />

      <controls:LabeledPicker Label="Buffered log level"
                              Description="Minimum log level retained in the in-memory diagnostics buffer."
                              PickerTitle="Select log level"
                              Key="host.minLogLevelInBuffer"
                              ValidationErrors="{Binding ValidationErrorsByPointer}"
                              ItemsSource="{Binding LogLevels}"
                              SelectedItem="{Binding Host.MinLogLevelInBuffer, Mode=TwoWay}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
