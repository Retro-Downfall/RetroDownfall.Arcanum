<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.OrchestrationPage"
             x:DataType="vm:ConfigurationViewModel">

    <ScrollViewer>

        <StackPanel Orientation="Vertical"
                    Margin="24"
                    Spacing="16">

            <TextBlock Text="Orchestration"
                       FontSize="{DynamicResource ForgePageTitleFontSize}"
                       FontWeight="SemiBold" />

            <TextBlock Text="Daemon"
                       FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                       FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Max concurrent jobs"
                                     Description="Caps the number of Unseen Servant jobs that can run concurrently."
                                     Key="daemon.maxConcurrentJobs"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.DaemonMaxConcurrentJobs, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="1024"
                                     Increment="1" />

            <controls:LabeledStepper Label="Shutdown drain (s)"
                                     Description="Maximum time StopAsync waits for in-flight jobs to drain after shutdown begins; 0 means no wait."
                                     Key="daemon.shutdownDrainTimeoutSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.DaemonShutdownDrainTimeoutSeconds, Mode=TwoWay}"
                                     Minimum="0"
                                     Maximum="600"
                                     Increment="1" />

            <controls:LabeledStepper Label="Execution history limit"
                                     Description="Maximum execution records retained per daemon in the in-memory history store."
                                     Key="daemon.executionHistoryLimit"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.DaemonExecutionHistoryLimit, Mode=TwoWay}"
                                     Minimum="10"
                                     Maximum="10000"
                                     Increment="1" />

            <Button Content="Add Job"
                    Command="{Binding Orchestration.AddJobCommand}" />

            <ItemsControl ItemsSource="{Binding Orchestration.Jobs}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate x:DataType="vm:OrchestrationSectionViewModel+UnseenServantJobViewModel">

                        <Border BorderBrush="{DynamicResource ForgeBorderBrush}"
                                BorderThickness="1"
                                Margin="0,8"
                                Padding="12">

                            <StackPanel Orientation="Vertical"
                                        Spacing="8">

                                <controls:LabeledEntry Label="Name"
                                                       Description="Human-readable name for this Unseen Servant job."
                                                       Text="{Binding Name, Mode=TwoWay}" />

                                <controls:LabeledStepper Label="Interval (m)"
                                                         Description="Minutes between scheduled runs of this job."
                                                         Value="{Binding IntervalMinutes, Mode=TwoWay}"
                                                         Minimum="1"
                                                         Maximum="10080"
                                                         Increment="1" />

                                <controls:LabeledEntry Label="Target spell"
                                                       Description="Spell invoked by this job on each tick."
                                                       Text="{Binding TargetSpell, Mode=TwoWay}"
                                                       Placeholder="lore-sweep" />

                                <controls:LabeledToggle Label="Enabled"
                                                        Description="When true, this job is eligible to run on its schedule."
                                                        IsOn="{Binding Enabled, Mode=TwoWay}" />

                                <Button Content="Remove"
                                        Command="{Binding $parent[UserControl].((vm:ConfigurationViewModel)DataContext).Orchestration.RemoveJobCommand}"
                                        CommandParameter="{Binding .}" />

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <TextBlock Text="Apprentices"
                       FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                       FontWeight="SemiBold" />

            <controls:LabeledToggle Label="Enabled"
                                    Description="Master toggle for the Apprentice autonomous sub-agent subsystem."
                                    IsOn="{Binding Orchestration.ApprenticesEnabled, Mode=TwoWay}" />

            <controls:LabeledStepper Label="Max concurrent apprentices"
                                     Description="Maximum Apprentices running simultaneously."
                                     Key="apprentices.maxConcurrentApprentices"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesMaxConcurrentApprentices, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="50"
                                     Increment="1" />

            <controls:LabeledStepper Label="Step timeout (m)"
                                     Description="Per-step timeout for an Apprentice's plan execution."
                                     Key="apprentices.stepTimeoutMinutes"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesStepTimeoutMinutes, Mode=TwoWay}"
                                     Minimum="5"
                                     Maximum="120"
                                     Increment="1" />

            <controls:LabeledStepper Label="Chronicle channel capacity"
                                     Description="Per-subscriber bounded channel capacity for Chronicle and session event hubs. Applied when a hub is first created."
                                     Key="apprentices.chronicleChannelCapacity"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesChronicleChannelCapacity, Mode=TwoWay}"
                                     Minimum="100"
                                     Maximum="10000"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max simulacra"
                                     Description="Maximum parallel Simulacrum steps within a single Apprentice plan step."
                                     Key="apprentices.maxSimulacra"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesMaxSimulacra, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="10"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max run steps"
                                     Description="Maximum steps in a single Apprentice run before forced termination."
                                     Key="apprentices.maxRunSteps"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesMaxRunSteps, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="500"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max run duration (m)"
                                     Description="Maximum wall-clock minutes for a single Apprentice run."
                                     Key="apprentices.maxRunDurationMinutes"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesMaxRunDurationMinutes, Mode=TwoWay}"
                                     Minimum="5"
                                     Maximum="10080"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max pending starts"
                                     Description="Maximum Apprentices waiting to start before new start requests are rejected."
                                     Key="apprentices.maxPendingStarts"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesMaxPendingStarts, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="1000"
                                     Increment="1" />

            <TextBlock Text="Second Wind (retry)"
                       FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                       FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Max step retries"
                                     Description="Maximum retries per failed Apprentice step (Second Wind)."
                                     Key="apprentices.maxStepRetries"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesMaxStepRetries, Mode=TwoWay}"
                                     Minimum="0"
                                     Maximum="10"
                                     Increment="1" />

            <controls:LabeledStepper Label="Retry backoff (s)"
                                     Description="Initial exponential-backoff seconds between retries."
                                     Key="apprentices.retryBackoffSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesRetryBackoffSeconds, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="300"
                                     Increment="1" />

            <controls:LabeledStepper Label="Retry backoff max (s)"
                                     Description="Cap for exponential-backoff seconds between retries."
                                     Key="apprentices.retryBackoffMaxSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesRetryBackoffMaxSeconds, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="3600"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max reweaves per run"
                                     Description="Maximum Shifting Fate plan re-weaves allowed in a single Apprentice run."
                                     Key="apprentices.maxReweavesPerRun"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ApprenticesMaxReweavesPerRun, Mode=TwoWay}"
                                     Minimum="0"
                                     Maximum="100"
                                     Increment="1" />

            <controls:LabeledToggle Label="Enable Shifting Fate"
                                    Description="When true, a failed step can trigger a plan re-weave (Shifting Fate)."
                                    IsOn="{Binding Orchestration.ApprenticesEnableShiftingFate, Mode=TwoWay}" />

            <controls:LabeledToggle Label="Enable Divine Intervention"
                                    Description="When true, an Escalated Apprentice surfaces for Divine Intervention via /api/apprentices/{id}/intervene."
                                    IsOn="{Binding Orchestration.ApprenticesEnableDivineIntervention, Mode=TwoWay}" />

            <TextBlock Text="Conclave"
                       FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                       FontWeight="SemiBold" />

            <controls:LabeledToggle Label="Enabled"
                                    Description="Gates cross-Apprentice delegation (Cast Sending). When false, the cast_sending tool is not advertised and /api/apprentices/{id}/cast refuses delegation."
                                    IsOn="{Binding Orchestration.ConclaveEnabled, Mode=TwoWay}" />

            <controls:LabeledStepper Label="Max delegation depth"
                                     Description="Maximum delegation depth from a Conclave root Apprentice (0 = root only, no children)."
                                     Key="conclave.maxDelegationDepth"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ConclaveMaxDelegationDepth, Mode=TwoWay}"
                                     Minimum="0"
                                     Maximum="20"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max descendants per root"
                                     Description="Maximum total descendant Apprentices allowed under one Conclave root."
                                     Key="conclave.maxDescendantsPerRoot"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Orchestration.ConclaveMaxDescendantsPerRoot, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="200"
                                     Increment="1" />

        </StackPanel>

    </ScrollViewer>

</UserControl>
