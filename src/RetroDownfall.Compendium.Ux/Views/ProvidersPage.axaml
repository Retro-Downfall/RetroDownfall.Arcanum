<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.ProvidersPage"
             x:DataType="vm:ConfigurationViewModel">

  <ScrollViewer>
    <StackPanel Margin="24"
                Spacing="16">

      <TextBlock Text="Providers &amp; Models"
                 FontSize="{DynamicResource ForgePageTitleFontSize}"
                 FontWeight="SemiBold" />

      <controls:LabeledEntry Label="Default model"
                             Description="Model used when a request does not select one."
                             Key="defaultModel"
                             ValidationErrors="{Binding ValidationErrorsByPointer}"
                             Text="{Binding Providers.DefaultModel, Mode=TwoWay}"
                             Placeholder="gpt-4o" />

      <controls:LabeledEntry Label="Fast model"
                             Description="Optional model used automatically for eligible internal work."
                             Key="fastModel"
                             ValidationErrors="{Binding ValidationErrorsByPointer}"
                             Text="{Binding Providers.FastModel, Mode=TwoWay}"
                             Placeholder="gpt-4o-mini" />

      <Button Content="Add Provider"
              HorizontalAlignment="Left"
              Command="{Binding Providers.AddProviderCommand}" />

      <ItemsControl ItemsSource="{Binding Providers.Providers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProvidersSectionViewModel+ProviderViewModel">
            <Border BorderBrush="{DynamicResource ForgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,8"
                    Padding="12">
              <StackPanel Spacing="8">

                <controls:LabeledEntry Label="Name"
                                       Description="Human-readable provider identity."
                                       Text="{Binding Name, Mode=TwoWay}"
                                       Placeholder="Local provider" />

                <controls:LabeledPicker Label="Type"
                                        Description="Provider wire contract."
                                        PickerTitle="Select type"
                                        ItemsSource="{Binding $parent[UserControl].((vm:ConfigurationViewModel)DataContext).ProviderKinds}"
                                        SelectedItem="{Binding Type, Mode=TwoWay}" />

<!-- Endpoint and credential are hidden rather than blanked for a subscription CLI: it has
                     neither, and rendering them empty-but-present reads as "required, and you have
                     not filled them in". -->
                <controls:LabeledEntry Label="Endpoint"
                                       Description="OpenAI-compatible base endpoint."
                                       Text="{Binding Endpoint, Mode=TwoWay}"
                                       IsVisible="{Binding IsHttpProvider}"
                                       Placeholder="https://api.openai.com/v1" />

                <controls:LabeledEntry Label="Credential environment variable"
                                       Description="Exact variable containing the API key. Leave blank to derive one from the provider name, such as ARCANUM_PROVIDER_OPENAI_API_KEY."
                                       Text="{Binding CredentialEnvironmentVariable, Mode=TwoWay}"
                                       IsVisible="{Binding IsHttpProvider}"
                                       Placeholder="OPENAI_API_KEY" />

                <StackPanel Spacing="8" IsVisible="{Binding IsFamiliar}">

                  <controls:LabeledEntry Label="Command"
                                         Description="The CLI to run. Leave blank to find it on your PATH. Arcanum never installs, updates, or signs into it."
                                         Text="{Binding Command, Mode=TwoWay}"
                                         Placeholder="/opt/homebrew/bin/claude" />

                  <TextBlock Text="{Binding ProbeStatus}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding ProbeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <TextBlock Text="{Binding ProbeRemediation}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource ForgeErrorBrush}"
                             IsVisible="{Binding HasProbeRemediation}" />

                  <SelectableTextBlock Text="{Binding ProbeRemediationCommand}"
                                       FontFamily="{DynamicResource ForgeCodeFontFamily}"
                                       IsVisible="{Binding HasProbeRemediationCommand}" />

                  <Button Content="Re-probe"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding !IsProbing}"
                          Command="{Binding ProbeCommand}" />

                  <controls:LabeledEntry Label="Hidden models"
                                         Description="Comma-separated model names to leave out of lists and pickers. Empty means every model the CLI offers is available, including ones released after you set this up. Hiding is a tidiness preference: a hidden model still runs if you name it directly."
                                         Text="{Binding HiddenModels, Mode=TwoWay}"
                                         Placeholder="claude-3-haiku-legacy" />

                </StackPanel>

                <controls:LabeledStepper Label="Context window limit"
                                         Description="Factual provider context-window capacity."
                                         Value="{Binding ContextWindowLimit, Mode=TwoWay}"
                                         Minimum="256"
                                         Maximum="2097152"
                                         Increment="128" />

                <TextBlock Text="Models"
                           FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                           FontWeight="SemiBold" />

                <ItemsControl ItemsSource="{Binding Models}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProvidersSectionViewModel+ModelEntryViewModel">
                      <Border Background="{DynamicResource ForgeSurfaceAltBrush}"
                              BorderBrush="{DynamicResource ForgeBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Margin="0,4"
                              Padding="10">
                        <StackPanel Spacing="8">

                          <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding Name, Mode=TwoWay}"
                                     PlaceholderText="gpt-4o" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                              <TextBlock Text="Vision"
                                         VerticalAlignment="Center" />
                              <ToggleSwitch IsChecked="{Binding SupportsVision, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                              <TextBlock Text="Tools"
                                         VerticalAlignment="Center" />
                              <CheckBox IsThreeState="True"
                                        IsChecked="{Binding SupportsTools, Mode=TwoWay}"
                                        ToolTip.Tip="Declared tool-calling capability. Indeterminate (default) means unset/undeclared; checked means this model can call tools; unchecked means it explicitly cannot." />
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Content="Remove"
                                    x:CompileBindings="False"
                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveModelCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>

                          <controls:LabeledToggle Label="Declare reasoning capability"
                                                  Description="Expose only factual controls and wire behavior verified for this model."
                                                  IsOn="{Binding HasReasoning, Mode=TwoWay}" />

                          <Expander Header="Reasoning capability"
                                    IsEnabled="{Binding HasReasoning}">
                            <StackPanel Margin="0,8,0,0"
                                        Spacing="8">

                              <controls:LabeledPicker Label="Wire dialect"
                                                      Description="Exact request wire shape required by this provider/model. Standard (OpenAI) is the default; set only for third-party endpoints needing a nonstandard numeric-budget shape."
                                                      PickerTitle="Select dialect"
                                                      ItemsSource="{Binding ReasoningWireDialectValues}"
                                                      SelectedItem="{Binding ReasoningDialect, Mode=TwoWay}" />

                              <CheckBox Content="Set a maximum numeric reasoning budget"
                                        IsChecked="{Binding HasReasoningMaxBudgetTokens, Mode=TwoWay}" />

                              <controls:LabeledStepper Label="Maximum reasoning budget"
                                                       Description="Maximum numeric reasoning budget accepted by this model (per single turn)."
                                                       IsEnabled="{Binding HasReasoningMaxBudgetTokens}"
                                                       Value="{Binding ReasoningMaxBudgetTokens, Mode=TwoWay}"
                                                       Minimum="1"
                                                       Maximum="2097152"
                                                       Increment="1" />

                            </StackPanel>
                          </Expander>

                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Add Model"
                        HorizontalAlignment="Left"
                        Command="{Binding AddModelCommand}" />

                <Button Content="Remove Provider"
                        HorizontalAlignment="Left"
                        Command="{Binding $parent[UserControl].((vm:ConfigurationViewModel)DataContext).Providers.RemoveProviderCommand}"
                        CommandParameter="{Binding .}" />

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
