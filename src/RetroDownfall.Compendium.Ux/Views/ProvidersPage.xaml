<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.ProvidersPage"
             Title="AI Providers">

    <ScrollView>

        <VerticalStackLayout Padding="24"
                             Spacing="16">

            <Label Text="AI Providers"
                   FontSize="24"
                   FontAttributes="Bold" />

            <controls:LabeledEntry Label="Default model"
                                   Description="Model used when a request does not specify one. Must match a models entry on some provider."
                                   Key="defaultModel"
                                   ValidationErrors="{Binding ValidationErrorsByPointer}"
                                   Text="{Binding Providers.DefaultModel, Mode=TwoWay}"
                                   Placeholder="deepseek-chat" />

            <controls:LabeledEntry Label="Fast model"
                                   Description="Model used for internal background summarization, semantic routing preflight, and semantic Inquisitor judges. Must match a models entry on some provider."
                                   Key="fastModel"
                                   ValidationErrors="{Binding ValidationErrorsByPointer}"
                                   Text="{Binding Providers.FastModel, Mode=TwoWay}"
                                   Placeholder="mistral:latest" />

            <Button Text="Add Provider"
                    Command="{Binding Providers.AddProviderCommand}" />

            <CollectionView ItemsSource="{Binding Providers.Providers}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                Padding="12"
                                Margin="0,8">

                            <VerticalStackLayout Spacing="8">

                                <controls:LabeledEntry Label="Name"
                                                       Description="Human-readable name for this provider entry."
                                                       Text="{Binding Name, Mode=TwoWay}"
                                                       Placeholder="Local Ollama" />

                                <controls:LabeledPicker Label="Type"
                                                        Description="Backend kind: Ollama (local OllamaSharp), OpenAI Compatible (any OpenAI-shaped HTTP API), or Llama Cpp Server (spawned local llama-server)."
                                                        PickerTitle="Select type"
                                                        ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProviderKinds}"
                                                        SelectedItem="{Binding Type, Mode=TwoWay}" />

                                <controls:LabeledEntry Label="Endpoint"
                                                       Description="Base URL for the provider API. Ollama: http://localhost:11434. OpenAI-compatible usually includes /v1. Ignored for LlamaCppServer."
                                                       Text="{Binding Endpoint, Mode=TwoWay}"
                                                       Placeholder="https://api.openai.com/v1" />

                                <controls:LabeledEntry Label="API key"
                                                       Description="Secret API key for this provider. Encrypted at rest with dp:v1: prefix; decrypted in the UI for editing. Leave blank for local Ollama."
                                                       Text="{Binding ApiKey, Mode=TwoWay}"
                                                       IsPassword="True"
                                                       Placeholder="sk-..." />

                                <controls:ChipsEditor Label="Models"
                                                      Description="Model IDs advertised by this provider. Must include the DefaultModel and FastModel if those reference this provider."
                                                      Text="{Binding Models, Mode=TwoWay}" />

                                <controls:LabeledStepper Label="Context window limit"
                                                         Description="Maximum tokens the hub will assemble into a single inference request for this provider. Clamp 256 - 2,097,152."
                                                         Value="{Binding ContextWindowLimit, Mode=TwoWay}"
                                                         Minimum="256"
                                                         Maximum="2097152"
                                                         Increment="128" />

                                <controls:LabeledEntry Label="LlamaCpp model map"
                                                       Description="Maps model keys to remote http/https URLs for on-demand GGUF download when the model is not yet cached. Only used when type is LlamaCppServer."
                                                       Text="{Binding LlamaCppModelMap, Mode=TwoWay}"
                                                       Placeholder="phi3=https://example.com/phi3.gguf" />

                                <Button Text="Remove"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Providers.RemoveProviderCommand}"
                                        CommandParameter="{Binding .}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
