<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.ProvingGroundsPage"
             Title="Proving Grounds">

    <ScrollView>

        <VerticalStackLayout Padding="24"
                             Spacing="16">

            <Label Text="Proving Grounds"
                   FontSize="24"
                   FontAttributes="Bold" />

            <controls:LabeledStepper Label="Max inquisitors per trial"
                                     Description="Maximum Inquisitors allowed on a single Trial."
                                     Key="provingGrounds.maxInquisitorsPerTrial"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding ProvingGrounds.MaxInquisitorsPerTrial, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="200"
                                     Increment="1" />

            <controls:LabeledStepper Label="Semantic judge max tokens"
                                     Description="Maximum completion tokens for a Semantic Inquisitor FastModel judge call."
                                     Key="provingGrounds.semanticJudgeMaxTokens"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding ProvingGrounds.SemanticJudgeMaxTokens, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="256"
                                     Increment="1" />

            <controls:LabeledStepper Label="Semantic judge timeout (s)"
                                     Description="Timeout for a Semantic Inquisitor judge inference call."
                                     Key="provingGrounds.semanticJudgeTimeoutSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding ProvingGrounds.SemanticJudgeTimeoutSeconds, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="600"
                                     Increment="1" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
