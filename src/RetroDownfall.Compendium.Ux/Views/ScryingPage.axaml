<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.ScryingPage"
             x:DataType="vm:ConfigurationViewModel">

    <ScrollViewer>

        <StackPanel Orientation="Vertical"
                    Margin="24"
                    Spacing="16">

            <TextBlock Text="Scrying (Vision/Multimodality)"
                       FontSize="{DynamicResource ForgePageTitleFontSize}"
                       FontWeight="SemiBold" />

            <TextBlock Text="Governs image content accepted on inference requests, independent of which models declare vision support (set per-model on the AI Providers page)."
                       FontSize="{DynamicResource ForgeUiSecondaryFontSize}"
                       Foreground="{DynamicResource ForgeMutedTextBrush}" />

            <controls:LabeledToggle Label="Scrying enabled"
                                    Description="Master kill-switch. When false, image content is rejected at the API boundary even for vision-capable models."
                                    IsOn="{Binding Scrying.Enabled, Mode=TwoWay}" />

            <controls:LabeledStepper Label="Max image bytes"
                                     Description="Maximum bytes per image, measured against the decoded data: URI payload. http(s)-hosted images are not size-checked here."
                                     Key="scrying.maxImageBytes"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Scrying.MaxImageBytes, Mode=TwoWay}"
                                     Minimum="1024"
                                     Maximum="20971520"
                                     Increment="1024" />

            <controls:LabeledStepper Label="Max images per request"
                                     Description="Maximum images per inference request (native Scrying foci and /v1 image_url parts combined)."
                                     Key="scrying.maxImagesPerRequest"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Scrying.MaxImagesPerRequest, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="100"
                                     Increment="1" />

            <controls:ChipsEditor Label="Allowed MIME types"
                                  Description="Allowed image MIME types. Only enforced for data: URI images; not enforced for http(s) URLs."
                                  Text="{Binding Scrying.AllowedMimeTypes, Mode=TwoWay}" />

        </StackPanel>

    </ScrollViewer>

</UserControl>
