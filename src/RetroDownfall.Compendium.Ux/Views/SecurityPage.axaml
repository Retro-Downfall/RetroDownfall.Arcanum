<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.SecurityPage"
             x:DataType="vm:ConfigurationViewModel">

    <ScrollViewer>

        <StackPanel Orientation="Vertical"
                    Margin="24"
                    Spacing="16">

            <TextBlock Text="Security / Wards"
                       FontSize="{DynamicResource ForgePageTitleFontSize}"
                       FontWeight="SemiBold" />

            <TextBlock Text="API Key"
                       FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                       FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Max API key header chars"
                                     Description="Maximum UTF-16 char length accepted in the X-Arcanum-Key / Authorization header."
                                     Key="security.maxApiKeyHeaderUtf16Chars"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Security.MaxApiKeyHeaderUtf16Chars, Mode=TwoWay}"
                                     Minimum="128"
                                     Maximum="8192"
                                     Increment="16" />

            <controls:LabeledStepper Label="API key cache TTL (s)"
                                     Description="TTL for the in-memory cache of the expected API key digest. After this window, on-disk rotation takes effect without a restart."
                                     Key="security.apiKeyCacheTtlSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Security.ApiKeyCacheTtlSeconds, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="3600"
                                     Increment="1" />

            <TextBlock Text="Wards"
                       FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                       FontWeight="SemiBold" />

            <controls:LabeledToggle Label="Wards enabled"
                                    Description="Master toggle for the Forbidden Arts approval gate."
                                    IsOn="{Binding Security.WardEnabled, Mode=TwoWay}" />

            <controls:ChipsEditor Label="Forbidden arts"
                                  Description="Tool names gated by the Ward approval flow before execution."
                                  Text="{Binding Security.ForbiddenArts, Mode=TwoWay}" />

            <controls:LabeledStepper Label="Ward timeout (s)"
                                     Description="Seconds before a pending Ward approval auto-expires."
                                     Key="ward.timeoutSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Security.WardTimeoutSeconds, Mode=TwoWay}"
                                     Minimum="10"
                                     Maximum="600"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max active wards"
                                     Description="Maximum simultaneously pending Ward approvals."
                                     Key="ward.maxActiveWards"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Security.WardMaxActiveWards, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="500"
                                     Increment="1" />

            <controls:LabeledToggle Label="Unattended mode"
                                    Description="Default for operator-facing chat (Command Center, ask/chat without --unattended). When true, Forbidden Arts follow auto-deny instead of placing wards. Daemons and other headless paths always run unattended."
                                    IsOn="{Binding Security.WardUnattendedMode, Mode=TwoWay}" />

            <controls:LabeledToggle Label="Auto-deny in unattended mode"
                                    Description="When true and the host is unattended, Ward approvals are auto-denied instead of hanging."
                                    IsOn="{Binding Security.WardAutoDenyInUnattendedMode, Mode=TwoWay}" />

        </StackPanel>

    </ScrollViewer>

</UserControl>
