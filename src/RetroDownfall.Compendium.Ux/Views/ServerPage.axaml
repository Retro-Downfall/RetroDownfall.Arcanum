<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.ServerPage"
             x:DataType="vm:ConfigurationViewModel">

    <ScrollViewer>

        <StackPanel Orientation="Vertical"
                    Margin="24"
                    Spacing="16">

            <TextBlock Text="Server"
                       FontSize="{DynamicResource ForgePageTitleFontSize}"
                       FontWeight="SemiBold" />

            <controls:LabeledEntry Label="PID file path"
                                   Description="Path to the arcanum.pid file written by `arcanum serve`. Defaults to ~/.config/arcanum/arcanum.pid."
                                   Key="server.pidFilePath"
                                   ValidationErrors="{Binding ValidationErrorsByPointer}"
                                   Text="{Binding Server.PidFilePath, Mode=TwoWay}"
                                   Placeholder="~/.config/arcanum/arcanum.pid" />

        </StackPanel>

    </ScrollViewer>

</UserControl>
