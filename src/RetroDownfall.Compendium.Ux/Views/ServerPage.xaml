<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RetroDownfall.Compendium.Ux.Views.Controls"
             x:Class="RetroDownfall.Compendium.Ux.Views.ServerPage"
             Title="Server">

    <ScrollView>

        <VerticalStackLayout Padding="24"
                             Spacing="16">

            <Label Text="Server"
                   FontSize="24"
                   FontAttributes="Bold" />

            <controls:LabeledEntry Label="PID file path"
                                   Description="Path to the arcanum.pid file written by `arcanum serve`. Defaults to ~/.config/arcanum/arcanum.pid."
                                   Key="server.pidFilePath"
                                   ValidationErrors="{Binding ValidationErrorsByPointer}"
                                   Text="{Binding Server.PidFilePath, Mode=TwoWay}"
                                   Placeholder="~/.config/arcanum/arcanum.pid" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
