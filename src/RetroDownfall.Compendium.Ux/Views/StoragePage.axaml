<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RetroDownfall.Compendium.Ux.Views.Controls"
             xmlns:vm="using:RetroDownfall.Compendium.Ux.ViewModels"
             x:Class="RetroDownfall.Compendium.Ux.Views.StoragePage"
             x:DataType="vm:ConfigurationViewModel">

    <ScrollViewer>

        <StackPanel Orientation="Vertical"
                    Margin="24"
                    Spacing="16">

<TextBlock Text="Storage &amp; Logging"
                   FontSize="{DynamicResource ForgePageTitleFontSize}"
                   FontWeight="SemiBold" />

            <TextBlock Text="Grimoire"
                   FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                   FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Max messages per conversation load"
                                     Description="Maximum entries loaded into memory for a single GetSessionAsync hydration; bounds RAM on long threads."
                                     Key="grimoire.maxMessagesPerConversationLoad"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.GrimoireMaxMessagesPerConversationLoad, Mode=TwoWay}"
                                     Minimum="50"
                                     Maximum="5000"
                                     Increment="1" />

            <controls:LabeledStepper Label="Workspace context retention"
                                     Description="Number of Chronosync WorkspaceContext snapshots retained per workspace path before older rows are purged."
                                     Key="grimoire.workspaceContextRetentionCount"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.GrimoireWorkspaceContextRetentionCount, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="1000"
                                     Increment="1" />

            <controls:LabeledStepper Label="Default Lore list limit"
                                     Description="Default page size for GET /api/lore when limit is omitted."
                                     Key="grimoire.defaultLoreListLimit"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.GrimoireDefaultLoreListLimit, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="10000"
                                     Increment="1" />

            <TextBlock Text="Sessions"
                   FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                   FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Default query limit"
                                     Description="Default page size for session entry queries when limit is omitted."
                                     Key="sessions.defaultQueryLimit"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.SessionsDefaultQueryLimit, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="10000"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max stream replay entries"
                                     Description="Maximum entries replayed to a newly connected session SSE subscriber."
                                     Key="sessions.maxStreamReplayEntries"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.SessionsMaxStreamReplayEntries, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="10000"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max entries per session"
                                     Description="Maximum entries allowed in a single session before inserts are rejected."
                                     Key="sessions.maxEntriesPerSession"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.SessionsMaxEntriesPerSession, Mode=TwoWay}"
                                     Minimum="100"
                                     Maximum="1000000"
                                     Increment="100" />

            <controls:LabeledStepper Label="Max entry content (bytes)"
                                     Description="Maximum byte size of a single session entry's content."
                                     Key="sessions.maxEntryContentBytes"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.SessionsMaxEntryContentBytes, Mode=TwoWay}"
                                     Minimum="1024"
                                     Maximum="16777216"
                                     Increment="1024" />

            <TextBlock Text="Event Bus"
                   FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                   FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Channel capacity"
                                     Description="Per-subscriber bounded channel capacity for live SSE push updates. When full, DropOldest discards the oldest frame."
                                     Key="eventBus.channelCapacity"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.EventBusChannelCapacity, Mode=TwoWay}"
                                     Minimum="64"
                                     Maximum="65536"
                                     Increment="1" />

            <controls:LabeledStepper Label="Heartbeat (s)"
                                     Description="SSE keep-alive comment interval for /api/events/*, session stream, and Chronicle. 0 disables heartbeats."
                                     Key="eventBus.heartbeatSeconds"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.EventBusHeartbeatSeconds, Mode=TwoWay}"
                                     Minimum="0"
                                     Maximum="300"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max SSE connections"
                                     Description="Maximum concurrent SSE connections across all event streams; excess requests get 503 Api.TooManyConnections."
                                     Key="eventBus.maxSseConnections"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.EventBusMaxSseConnections, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="100"
                                     Increment="1" />

            <controls:LabeledStepper Label="Max SSE connections per type"
                                     Description="Maximum concurrent SSE connections per event-type family (daemon, MCP, logs, session, Chronicle); guarantees a fair share of the global pool so one stream family cannot starve the others."
                                     Key="eventBus.maxSseConnectionsPerType"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.EventBusMaxSseConnectionsPerType, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="50"
                                     Increment="1" />

            <TextBlock Text="Logs"
                   FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                   FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Ring buffer capacity"
                                     Description="Capacity of the in-memory log ring buffer. Read once at construction; changes require a restart."
                                     Key="logs.ringBufferCapacity"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.LogsRingBufferCapacity, Mode=TwoWay}"
                                     Minimum="1000"
                                     Maximum="100000"
                                     Increment="1000" />

            <controls:LabeledPicker Label="Min level in buffer"
                                    Description="Minimum log level retained in the in-memory ring buffer."
                                    PickerTitle="Select level"
                                    Key="logs.minLevelInBuffer"
                                    ValidationErrors="{Binding ValidationErrorsByPointer}"
                                    ItemsSource="{Binding LogLevels}"
                                    SelectedItem="{Binding Storage.LogsMinLevelInBuffer, Mode=TwoWay}" />

            <TextBlock Text="Workspaces"
                   FontSize="{DynamicResource ForgeSectionHeaderFontSize}"
                   FontWeight="SemiBold" />

            <controls:LabeledStepper Label="Max file read (bytes)"
                                     Description="Maximum byte size of a single workspace file read via the API."
                                     Key="workspaces.maxFileReadSizeBytes"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.WorkspacesMaxFileReadSizeBytes, Mode=TwoWay}"
                                     Minimum="1024"
                                     Maximum="10485760"
                                     Increment="1024" />

            <controls:LabeledStepper Label="List directory max depth"
                                     Description="Maximum directory depth for recursive workspace file listing."
                                     Key="workspaces.listDirectoryMaxDepth"
                                     ValidationErrors="{Binding ValidationErrorsByPointer}"
                                     Value="{Binding Storage.WorkspacesListDirectoryMaxDepth, Mode=TwoWay}"
                                     Minimum="1"
                                     Maximum="256"
                                     Increment="1" />

        </StackPanel>

    </ScrollViewer>

</UserControl>
