<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PathGeometry icon resources for The Forge, keyed by domain concept. Consumed via Avalonia's
    built-in PathIcon (Data="{StaticResource IconSpell}"). Placeholder minimal set for Phase 1 —
    the full icon catalog (apprentice, ward, campaign, session, MCP, model, ...) lands in Phase 10
    alongside the Dark/Light theme resource dictionaries.
  -->
  <StreamGeometry x:Key="IconSpell">M12,2 L14,9 L21,9 L15.5,13.5 L17.5,21 L12,16.8 L6.5,21 L8.5,13.5 L3,9 L10,9 Z</StreamGeometry>
  <StreamGeometry x:Key="IconCampaign">M3,4 L21,4 L21,20 L3,20 Z M6,7 L18,7 M6,11 L18,11 M6,15 L14,15</StreamGeometry>
  <StreamGeometry x:Key="IconWorkspace">M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSession">M4,4 L20,4 L20,16 L8,16 L4,20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPrompt">M5,3 L19,3 L19,21 L5,21 Z M8,7 L16,7 M8,11 L16,11 M8,15 L13,15</StreamGeometry>
  <StreamGeometry x:Key="IconCodex">M5,4 L17,4 C18.1,4 19,4.9 19,6 L19,20 L7,20 C5.9,20 5,19.1 5,18 Z M8,7 L16,7 M8,10 L16,10</StreamGeometry>
  <StreamGeometry x:Key="IconSanctum">M12,2 L20,6 L20,12 C20,17 16.5,20.5 12,22 C7.5,20.5 4,17 4,12 L4,6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconConnectionOk">M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconConnectionError">M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,2 12,2 Z M13,17 L11,17 L11,15 L13,15 Z M13,13 L11,13 L11,7 L13,7 Z</StreamGeometry>
</ResourceDictionary>
