<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Visual Studio 2026–aligned typography: Segoe UI Variable for chrome, Cascadia for code. -->
  <FontFamily x:Key="ForgeUiFontFamily">Segoe UI Variable, Segoe UI, system-ui, sans-serif</FontFamily>
  <FontFamily x:Key="ForgeCodeFontFamily">Cascadia Mono, Cascadia Code, Consolas, monospace</FontFamily>
  <x:Double x:Key="ForgeUiFontSize">12</x:Double>
  <x:Double x:Key="ForgeUiSecondaryFontSize">11</x:Double>
  <x:Double x:Key="ForgeCodeFontSize">12</x:Double>
  <x:Double x:Key="ForgeTitleFontSize">14</x:Double>
  <x:Double x:Key="ForgeAnvilHeight">24</x:Double>
</ResourceDictionary>
