<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroDownfall.TheForge.Ux.ViewModels.Arsenal"
             xmlns:arsenalViews="using:RetroDownfall.TheForge.Ux.Views.Arsenal"
             xmlns:reliquaryViews="using:RetroDownfall.TheForge.Ux.Views.Reliquary"
             x:Class="RetroDownfall.TheForge.Ux.Views.Arsenal.ArsenalView"
             x:DataType="vm:ArsenalViewModel">
  <TabControl>
    <TabItem Header="MCP Servers">
      <arsenalViews:McpServersView DataContext="{Binding McpServers}" />
    </TabItem>
    <TabItem Header="Scrying Pool">
      <arsenalViews:ScryingPoolView DataContext="{Binding ScryingPool}" />
    </TabItem>
    <TabItem Header="Models &amp; Providers">
      <arsenalViews:ModelsProvidersView DataContext="{Binding ModelsProviders}" />
    </TabItem>
    <TabItem Header="Reliquary">
      <reliquaryViews:ReliquaryView DataContext="{Binding Reliquary}" />
    </TabItem>
  </TabControl>
</UserControl>
