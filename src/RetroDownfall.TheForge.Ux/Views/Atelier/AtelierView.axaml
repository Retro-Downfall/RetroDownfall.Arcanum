<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroDownfall.TheForge.Ux.ViewModels.Atelier"
             xmlns:controls="using:RetroDownfall.TheForge.Ux.Views.Controls"
             x:Class="RetroDownfall.TheForge.Ux.Views.Atelier.AtelierView"
             x:DataType="vm:AtelierViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource ForgeTitleFontSize}" FontWeight="SemiBold" />
        <TextBlock Text="Campaigns, workspaces, spells, and Tomes" Opacity="0.66" FontSize="11" />
      </StackPanel>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1">
      <controls:SpellTreeView />
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12">
        <TextBlock Text="{Binding EmptyState}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.72" MaxWidth="220" />
      </Border>
      <Border IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12">
        <StackPanel Spacing="8">
          <ProgressBar IsIndeterminate="True" Width="160" />
          <TextBlock Text="Reading the Atelier..." HorizontalAlignment="Center" Opacity="0.72" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
