<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroDownfall.TheForge.Ux.ViewModels"
        xmlns:workbench="using:RetroDownfall.TheForge.Ux.ViewModels.Workbench"
        xmlns:workbenchViews="using:RetroDownfall.TheForge.Ux.Views.Workbench"
        xmlns:dockViews="using:RetroDownfall.TheForge.Ux.Views.Docking"
        xmlns:anvil="using:RetroDownfall.TheForge.Ux.Views.Anvil"
        xmlns:whispers="using:RetroDownfall.TheForge.Ux.Views.Whispers"
        x:Class="RetroDownfall.TheForge.Ux.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="The Forge — Inference IDE"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">
  <Window.DataTemplates>
    <DataTemplate DataType="workbench:SpellEditorViewModel">
      <workbenchViews:SpellEditorView />
    </DataTemplate>
    <DataTemplate DataType="workbench:TomeViewModel">
      <workbenchViews:TomeView />
    </DataTemplate>
    <DataTemplate DataType="workbench:ScriptoriumViewModel">
      <workbenchViews:ScriptoriumView />
    </DataTemplate>
    <DataTemplate DataType="workbench:CodexViewModel">
      <workbenchViews:CodexView />
    </DataTemplate>
    <DataTemplate DataType="workbench:MarkdownDocumentViewModel">
      <workbenchViews:MarkdownDocumentView />
    </DataTemplate>
    <DataTemplate DataType="workbench:ProvingGroundsViewModel">
      <workbenchViews:ProvingGroundsView />
    </DataTemplate>
    <DataTemplate DataType="workbench:ComparisonWorkbenchViewModel">
      <workbenchViews:ComparisonWorkbenchView />
    </DataTemplate>
    <DataTemplate DataType="workbench:WorkbenchDocumentPlaceholderViewModel">
      <Border Padding="24">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource ForgeTitleFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyState}" Opacity="0.72" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto">

    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,1">
      <Menu DockPanel.Dock="Left">
        <MenuItem Header="_File" />
        <MenuItem Header="_Edit" />
        <MenuItem Header="_View">
          <MenuItem Header="Reset Window Layout" Command="{Binding ResetWindowLayoutCommand}" />
          <Separator />
          <MenuItem Header="The Atelier" Command="{Binding ShowAtelierCommand}" />
          <MenuItem Header="The Gatehouse" Command="{Binding ShowGatehouseCommand}" />
          <MenuItem Header="The Treasury" Command="{Binding ShowTreasuryCommand}" />
          <MenuItem Header="The Arsenal" Command="{Binding ShowArsenalCommand}" />
          <MenuItem Header="The War Table" Command="{Binding ShowWarTableCommand}" />
          <MenuItem Header="Output" Command="{Binding ShowOutputCommand}" />
          <MenuItem Header="Logs" Command="{Binding ShowLogsCommand}" />
          <MenuItem Header="The Hearth" Command="{Binding ShowHearthCommand}" />
          <MenuItem Header="Lore Browser" Command="{Binding ShowLoreCommand}" />
          <MenuItem Header="The Archive" Command="{Binding ShowArchiveCommand}" />
          <MenuItem Header="Divination" Command="{Binding ShowDivinationCommand}" />
          <MenuItem Header="Workspace Explorer" Command="{Binding ShowWorkspaceExplorerCommand}" />
          <MenuItem Header="The Weave Inspector" Command="{Binding ShowWeaveInspectorCommand}" />
          <MenuItem Header="The Codex" Command="{Binding OpenGlobalCodexCommand}" />
          <Separator />
          <MenuItem Header="Connect to Arcanum" Command="{Binding ConnectCommand}" />
          <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
          <MenuItem Header="Setup wizard…" Command="{Binding Anvil.OpenSetupWizardCommand}" />
          <MenuItem Header="Open Compendium" Command="{Binding Anvil.OpenCompendiumCommand}" />
        </MenuItem>
        <MenuItem Header="_Campaign" />
        <MenuItem Header="_Spell" />
        <MenuItem Header="_Apprentice" />
        <MenuItem Header="_Trial">
          <MenuItem Header="Proving Grounds" Command="{Binding OpenProvingGroundsCommand}" />
          <MenuItem Header="Comparison Workbench" Command="{Binding OpenComparisonWorkbenchCommand}" />
        </MenuItem>
        <MenuItem Header="_Tools" />
        <MenuItem Header="_Help" />
      </Menu>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" Spacing="10">
        <TextBlock Text="The Forge — Inference IDE" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Padding="8,2" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ForgeBorderBrush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource ForgeAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <dockViews:DockHostView />
      <whispers:WhispersHostView x:Name="WhispersHost"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="12"
                                 IsHitTestVisible="True" />
    </Grid>

    <anvil:AnvilView Grid.Row="2" DataContext="{Binding Anvil}" />

  </Grid>
</Window>
