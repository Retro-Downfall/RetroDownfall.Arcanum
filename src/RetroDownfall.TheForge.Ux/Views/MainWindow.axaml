<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RetroDownfall.TheForge.Ux.ViewModels"
        xmlns:workbench="using:RetroDownfall.TheForge.Ux.ViewModels.Workbench"
        xmlns:workbenchViews="using:RetroDownfall.TheForge.Ux.Views.Workbench"
        xmlns:atelierViews="using:RetroDownfall.TheForge.Ux.Views.Atelier"
        xmlns:anvil="using:RetroDownfall.TheForge.Ux.Views.Anvil"
        x:Class="RetroDownfall.TheForge.Ux.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="The Forge — Inference IDE"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">
  <Window.DataTemplates>
    <DataTemplate DataType="workbench:SpellEditorViewModel">
      <workbenchViews:SpellEditorView />
    </DataTemplate>
    <DataTemplate DataType="workbench:TomeViewModel">
      <workbenchViews:TomeView />
    </DataTemplate>
    <DataTemplate DataType="workbench:WorkbenchDocumentPlaceholderViewModel">
      <Border Padding="24">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyState}" Opacity="0.72" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,1">
      <Menu DockPanel.Dock="Left">
        <MenuItem Header="_File" />
        <MenuItem Header="_Edit" />
        <MenuItem Header="_View">
          <MenuItem Header="Toggle The Atelier" Command="{Binding ToggleAtelierCommand}" />
          <MenuItem Header="Toggle Right Panel" Command="{Binding ToggleRightPanelCommand}" />
          <MenuItem Header="Toggle The Foundry Floor" Command="{Binding ToggleFoundryFloorCommand}" />
        </MenuItem>
        <MenuItem Header="_Campaign" />
        <MenuItem Header="_Spell" />
        <MenuItem Header="_Apprentice" />
        <MenuItem Header="_Trial" />
        <MenuItem Header="_Tools" />
        <MenuItem Header="_Help" />
      </Menu>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" Spacing="10">
        <TextBlock Text="The Forge — Inference IDE" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Padding="8,2" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ForgeShellBorderBrush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource ForgeShellAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding IsAtelierVisible, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=260}" />
        <ColumnDefinition Width="{Binding IsAtelierVisible, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=5}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{Binding IsRightPanelVisible, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=5}" />
        <ColumnDefinition Width="{Binding IsRightPanelVisible, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=330}" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" IsVisible="{Binding IsAtelierVisible}" Padding="12" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ForgeShellBorderBrush}">
        <atelierViews:AtelierView DataContext="{Binding Atelier}" />
      </Border>

      <GridSplitter Grid.Column="1" IsVisible="{Binding IsAtelierVisible}" Width="5" ResizeDirection="Columns" />

      <Border Grid.Column="2" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="The Workbench" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

          <TabControl Grid.Row="1" ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding ActiveDocument}">
            <TabControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>

          <Border Grid.Row="1" IsVisible="{Binding HasNoOpenDocuments}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
            <StackPanel Spacing="10">
              <TextBlock Text="The Workbench is ready." FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Open a spell, prompt, session, apprentice, trial, or config document to begin forging." Opacity="0.72" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" IsVisible="{Binding IsRightPanelVisible}" Width="5" ResizeDirection="Columns" />

      <Border Grid.Column="4" IsVisible="{Binding IsRightPanelVisible}" Padding="10" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ForgeShellBorderBrush}">
        <TabControl>
          <TabItem Header="The Gatehouse">
            <TextBlock Text="{Binding Gatehouse.EmptyState}" TextWrapping="Wrap" Margin="8" />
          </TabItem>
          <TabItem Header="The Treasury">
            <TextBlock Text="{Binding Treasury.EmptyState}" TextWrapping="Wrap" Margin="8" />
          </TabItem>
          <TabItem Header="The Arsenal">
            <TextBlock Text="{Binding Arsenal.EmptyState}" TextWrapping="Wrap" Margin="8" />
          </TabItem>
          <TabItem Header="The War Table">
            <TextBlock Text="{Binding WarTable.EmptyState}" TextWrapping="Wrap" Margin="8" />
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <GridSplitter Grid.Row="2" IsVisible="{Binding IsFoundryFloorVisible}" Height="5" ResizeDirection="Rows" />

    <Border Grid.Row="3" IsVisible="{Binding IsFoundryFloorVisible}" Height="190" Padding="8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ForgeShellBorderBrush}">
      <TabControl>
        <TabItem Header="Output">
          <TextBlock Text="{Binding FoundryFloor.OutputEmptyState}" TextWrapping="Wrap" Margin="8" />
        </TabItem>
        <TabItem Header="Logs">
          <Grid>
            <TextBlock Text="{Binding FoundryFloor.LogsEmptyState}"
                       IsVisible="{Binding FoundryFloor.HasNoLines}"
                       TextWrapping="Wrap"
                       Margin="8" />
            <ListBox ItemsSource="{Binding FoundryFloor.Lines}"
                     IsVisible="{Binding !FoundryFloor.HasNoLines}"
                     BorderThickness="0" />
          </Grid>
        </TabItem>
        <TabItem Header="The Hearth">
          <TextBlock Text="{Binding Hearth.EmptyState}" TextWrapping="Wrap" Margin="8" />
        </TabItem>
      </TabControl>
    </Border>

    <anvil:AnvilView Grid.Row="4" DataContext="{Binding Anvil}" />

  </Grid>
</Window>
