<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroDownfall.TheForge.Ux.ViewModels.WeaveInspector"
             xmlns:tower="using:RetroDownfall.Arcanum.Core.Tower"
             xmlns:workspaces="using:RetroDownfall.Arcanum.Core.Workspaces"
             x:Class="RetroDownfall.TheForge.Ux.Views.WeaveInspector.WeaveInspectorView"
             x:DataType="vm:WeaveInspectorViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="{DynamicResource ForgeTitleFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Opacity="0.6" Margin="12,0,0,0" VerticalAlignment="Center" />
      <TextBlock DockPanel.Dock="Right" Text="Busy…" Opacity="0.65" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
      <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
    </DockPanel>

    <TextBlock Grid.Row="1" Text="{Binding ManagedWeaveBannerMessage}" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding ShowManagedWeaveBanner}" />

    <TextBlock Grid.Row="2" Text="{Binding LastError}" Foreground="{DynamicResource ForgeErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TabControl Grid.Row="3" SelectedIndex="{Binding ActiveTabIndex}">

      <TabItem Header="Index">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

          <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="Workspace" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" MinWidth="180">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="workspaces:WorkspaceInfo">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>

            <StackPanel Spacing="2">
              <TextBlock Text="{Binding VectorModeText, StringFormat=Vector mode: {0}}" Opacity="0.8" />
              <TextBlock Text="{Binding VectorDiagnosticText, StringFormat={}{0}}" Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}" IsVisible="{Binding VectorDiagnosticText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding StatusSummaryText}" Opacity="0.85" IsVisible="{Binding StatusSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <TextBlock Text="{Binding IndexingDisabledMessage}" Foreground="{DynamicResource ForgeErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding !IndexingEnabled}" />
            <Button Content="Copy setting paths" Command="{Binding CopyDisabledPathsCommand}" CommandParameter="WorkspaceIndexing" HorizontalAlignment="Left" IsVisible="{Binding !IndexingEnabled}" />

            <TextBlock Text="{Binding SkippedFilesNote}" Opacity="0.6" TextWrapping="Wrap" FontSize="{DynamicResource ForgeUiSecondaryFontSize}" IsVisible="{Binding SkippedFilesNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <DockPanel LastChildFill="False">
              <Button DockPanel.Dock="Left" Content="Re-index" Command="{Binding ReindexCommand}" IsEnabled="{Binding IndexingEnabled}" />
              <TextBlock DockPanel.Dock="Left" Text="Indexing…" Opacity="0.65" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsIndexing}" />
              <Button DockPanel.Dock="Right" Content="Reset embeddings…" Command="{Binding ResetEmbeddingsCommand}" IsEnabled="{Binding IndexingEnabled}" />
              <TextBlock DockPanel.Dock="Right" Text="Resetting…" Opacity="0.65" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsResetting}" />
            </DockPanel>
          </StackPanel>

          <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,6">
            <TextBox DockPanel.Dock="Left" Text="{Binding ChunkFilterRelativePath}" PlaceholderText="Filter by relative path (optional)…" MinWidth="220" />
            <Button DockPanel.Dock="Left" Content="Load chunks" Command="{Binding LoadChunksCommand}" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Next" Command="{Binding NextChunkPageCommand}" IsEnabled="{Binding CanGoNextChunkPage}" />
            <Button DockPanel.Dock="Right" Content="Prev" Command="{Binding PreviousChunkPageCommand}" IsEnabled="{Binding CanGoPreviousChunkPage}" Margin="0,0,6,0" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding ChunkRangeText}" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,8,0" />
          </DockPanel>

          <ListBox Grid.Row="2" ItemsSource="{Binding Chunks}" SelectedItem="{Binding SelectedChunk}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="workspaces:WorkspaceFileChunkDto">
                <Border Margin="0,0,0,6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource ForgeBorderBrush}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="Chunk {0} of {1}">
                          <Binding Path="ChunkIndex" />
                          <Binding Path="TotalChunksForFile" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ContentPreview}" TextWrapping="Wrap" MaxLines="3" Opacity="0.85" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="3" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource ForgeBorderBrush}" Margin="0,8,0,0" IsVisible="{Binding SelectedChunk, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding SelectedChunk?.RelativePath}" FontWeight="SemiBold" />
              <TextBlock Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="Chunk {0} of {1}">
                    <Binding Path="SelectedChunk?.ChunkIndex" />
                    <Binding Path="SelectedChunk?.TotalChunksForFile" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Text="{Binding SelectedChunk?.ContentPreview}" TextWrapping="Wrap" />
              <TextBlock Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="Char offset: {0}, length: {1}">
                    <Binding Path="SelectedChunk?.CharOffset" />
                    <Binding Path="SelectedChunk?.CharLength" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Border>

        </Grid>
      </TabItem>

      <TabItem Header="Workspace Divination">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="{Binding WorkspaceFeatureDisabledMessage}" Foreground="{DynamicResource ForgeErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding WorkspaceFeatureDisabled}" />
            <Button Content="Copy setting paths" Command="{Binding CopyDisabledPathsCommand}" CommandParameter="WorkspaceDivination" HorizontalAlignment="Left" IsVisible="{Binding WorkspaceFeatureDisabled}" />
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="Workspace" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" MinWidth="150">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="workspaces:WorkspaceInfo">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox DockPanel.Dock="Left" Text="{Binding WorkspaceQuery}" PlaceholderText="Query…" MinWidth="150" Margin="6,0,0,0" />
              <Button DockPanel.Dock="Left" Content="Search" Command="{Binding SearchWorkspaceCommand}" Margin="6,0,0,0" IsEnabled="{Binding !WorkspaceFeatureDisabled}" />
              <TextBlock DockPanel.Dock="Left" Text="Searching…" Opacity="0.65" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsSearchingWorkspace}" />
            </DockPanel>
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding WorkspaceResults}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="workspaces:WorkspaceSearchResult">
                <Border Margin="0,0,0,6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource ForgeBorderBrush}">
                  <StackPanel Spacing="3">
                    <DockPanel LastChildFill="False">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding RelativePath}" FontWeight="SemiBold" />
                      <Button DockPanel.Dock="Right" Content="Browse chunks" Command="{Binding $parent[UserControl].((vm:WeaveInspectorViewModel)DataContext)?.LoadChunksForFileCommand}" CommandParameter="{Binding RelativePath}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ContentPreview}" TextWrapping="Wrap" MaxLines="4" Opacity="0.85" />
                    <TextBlock Text="{Binding Similarity, StringFormat=Similarity: {0:0.00}}" Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Saga">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="{Binding SagaFeatureDisabledMessage}" Foreground="{DynamicResource ForgeErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding SagaFeatureDisabled}" />
            <Button Content="Copy setting paths" Command="{Binding CopyDisabledPathsCommand}" CommandParameter="SagaDivination" HorizontalAlignment="Left" IsVisible="{Binding SagaFeatureDisabled}" />
            <DockPanel LastChildFill="False">
              <TextBox DockPanel.Dock="Left" Text="{Binding SagaQuery}" PlaceholderText="Saga Divination query…" MinWidth="200" />
              <Button DockPanel.Dock="Left" Content="Search" Command="{Binding SearchSagaCommand}" Margin="6,0,0,0" IsEnabled="{Binding !SagaFeatureDisabled}" />
              <TextBlock DockPanel.Dock="Left" Text="Searching…" Opacity="0.65" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsSearchingSaga}" />
            </DockPanel>
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="{Binding SagaStatsText}" Opacity="0.7" VerticalAlignment="Center" />
              <Button DockPanel.Dock="Left" Content="Refresh stats" Command="{Binding RefreshSagaStatsCommand}" Margin="8,0,0,0" />
            </DockPanel>
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding SagaResults}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SagaMemoryWithSimilarity">
                <Border Margin="0,0,0,6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource ForgeBorderBrush}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Memory.Content}" TextWrapping="Wrap" MaxLines="4" />
                    <TextBlock Text="{Binding Memory.CreatedAt, StringFormat={}{0:g}}" Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}" />
                    <TextBlock Text="{Binding Similarity, StringFormat=Similarity: {0:0.00}}" Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Sessions">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="{Binding SessionsFeatureDisabledMessage}" Foreground="{DynamicResource ForgeErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding SessionsFeatureDisabled}" />
            <Button Content="Copy setting paths" Command="{Binding CopyDisabledPathsCommand}" CommandParameter="SessionDivination" HorizontalAlignment="Left" IsVisible="{Binding SessionsFeatureDisabled}" />
            <DockPanel LastChildFill="False">
              <TextBox DockPanel.Dock="Left" Text="{Binding SessionQuery}" PlaceholderText="Session Divination query…" MinWidth="200" />
              <Button DockPanel.Dock="Left" Content="Search" Command="{Binding SearchSessionsCommand}" Margin="6,0,0,0" IsEnabled="{Binding !SessionsFeatureDisabled}" />
              <TextBlock DockPanel.Dock="Left" Text="Searching…" Opacity="0.65" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsSearchingSessions}" />
            </DockPanel>
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding SessionResults}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="tower:SemanticSessionSearchResult">
                <Border Margin="0,0,0,6" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource ForgeBorderBrush}">
                  <StackPanel Spacing="3">
                    <DockPanel LastChildFill="False">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding SessionTitle}" FontWeight="SemiBold" />
                      <Button DockPanel.Dock="Right" Content="Open in Tome" Command="{Binding $parent[UserControl].((vm:WeaveInspectorViewModel)DataContext)?.OpenSessionResultCommand}" CommandParameter="{Binding}" />
                    </DockPanel>
                    <TextBlock Text="{Binding EntryContentPreview}" TextWrapping="Wrap" MaxLines="3" Opacity="0.85" />
                    <TextBlock Text="{Binding Similarity, StringFormat=Similarity: {0:0.00}}" Opacity="0.6" FontSize="{DynamicResource ForgeUiSecondaryFontSize}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
