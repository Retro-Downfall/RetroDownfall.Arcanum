<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroDownfall.TheForge.Ux.ViewModels.Workbench"
             x:Class="RetroDownfall.TheForge.Ux.Views.Workbench.TomeView"
             x:DataType="vm:TomeViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Spacing="2">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Session.Status}" Opacity="0.68" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button Content="Fork" Command="{Binding ForkCommand}" />
        <Button Content="Export" Command="{Binding ExportCommand}" />
        <Button Content="Manual Entry" Command="{Binding AppendManualEntryCommand}" />
        <Button Content="Send" Command="{Binding SendCommand}" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1"
            Height="10"
            Margin="0,0,0,8"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{DynamicResource ForgeShellBorderBrush}"
            ClipToBounds="True">
      <Border Background="{DynamicResource ForgeShellAccentBrush}"
              HorizontalAlignment="Left"
              Width="{Binding ManaPercent}" />
    </Border>

    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChatMessageViewModel">
            <Border Margin="0,0,0,10"
                    Padding="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ForgeShellBorderBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Role}"
                           FontWeight="SemiBold"
                           Opacity="0.8" />

                <TextBlock Text="{Binding Content}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Expander Header="{Binding ToolCall.Name}"
                          IsVisible="{Binding ToolCall, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Margin="0,4,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding ToolCall.ArgumentsJson}" TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock Text="{Binding ToolCall.Result}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ToolCall.ErrorMessage}"
                               IsVisible="{Binding ToolCall.HasError}"
                               Foreground="{DynamicResource ForgeShellAccentBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,4">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding ManaPercent, StringFormat=Mana: {0:0}%}" Opacity="0.72" />
        <TextBlock Text="{Binding LastUsage.TotalTokens, StringFormat=Tokens: {0}}" Opacity="0.72" />
        <TextBlock Text="Streaming…" IsVisible="{Binding IsStreaming}" Opacity="0.72" />
        <TextBlock Text="Ward pending — open The Gatehouse"
                   IsVisible="{Binding WardPending}"
                   Opacity="0.85" />
        <TextBlock Text="{Binding LastWhisper}" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
      <TextBox Text="{Binding ManualEntryText}"
               Watermark="Manual entry (system note)…"
               MinHeight="36" />
    </StackPanel>

    <TextBox Grid.Row="4"
             Text="{Binding InputText}"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="72"
             Watermark="Write in The Tome… Enter sends; Shift+Enter for a new line"
             KeyDown="OnInputKeyDown" />
  </Grid>
</UserControl>
