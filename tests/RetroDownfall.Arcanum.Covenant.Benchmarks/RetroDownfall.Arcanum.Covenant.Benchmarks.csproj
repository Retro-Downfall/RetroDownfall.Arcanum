<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately outside RetroDownfall.Arcanum.slnx, following tests/RetroDownfall.Arcanum.RegexAotSmoke.
    A test project the solution carries but no lane runs is a dark suite, and ContinuousIntegrationWorkflowTests
    enforces that by demanding a `dotnet test` line for every tests/ entry in the solution. This is a console
    host, not a test project: scripts/benchmark-covenant.sh is what runs it.
  -->

  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>RetroDownfall.Arcanum.Covenant.Benchmarks</RootNamespace>

    <AssemblyName>RetroDownfall.Arcanum.Covenant.Benchmarks</AssemblyName>

    <!-- Published AOT and measured as published. A gate on a JIT-warmed host would report numbers the
         shipped binary never produces, and the shipped CLI is Native AOT. -->
    <PublishAot>true</PublishAot>

    <IsAotCompatible>true</IsAotCompatible>

    <IsTrimmable>true</IsTrimmable>

    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Server GC would move the allocation numbers under the measurement rather than under the code
         being measured, and the paired control subtraction assumes one collector for the whole run. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

  </PropertyGroup>

  <ItemGroup>

    <ProjectReference Include="..\..\src\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <EmbeddedResource Include="covenant-workload-v1.json" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Update="Microsoft.Bcl.Memory" Version="10.0.10" />

  </ItemGroup>

</Project>
