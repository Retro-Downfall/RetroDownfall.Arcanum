<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="DisableImplicitLibraryPacksFolder">

  <!-- Deliberately outside RetroDownfall.Arcanum.slnx. The operator script publishes and runs it. -->
  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>RetroDownfall.Arcanum.GrimoireAdmission.Benchmarks</RootNamespace>

    <AssemblyName>RetroDownfall.Arcanum.GrimoireAdmission.Benchmarks</AssemblyName>

    <PublishAot>true</PublishAot>

    <IsAotCompatible>true</IsAotCompatible>

    <IsTrimmable>true</IsTrimmable>

    <InvariantGlobalization>true</InvariantGlobalization>

    <ServerGarbageCollection>false</ServerGarbageCollection>

    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- SDK library packs can reuse an official version with repackaged bytes. This benchmark's
         cross-machine lock file must resolve only the repository-declared NuGet sources. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>

    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/nuget-packages</RestorePackagesPath>

  </PropertyGroup>

  <ItemGroup>

    <ProjectReference Include="..\..\src\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <EmbeddedResource Include="grimoire-admission-workload-v1.json" />

    <EmbeddedResource Include="grimoire-admission-input-catalog-v1.txt" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Update="Microsoft.Bcl.Memory" Version="10.0.10" />

  </ItemGroup>

</Project>
