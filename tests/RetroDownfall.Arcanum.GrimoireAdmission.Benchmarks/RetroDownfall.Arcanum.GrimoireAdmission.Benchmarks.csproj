<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside RetroDownfall.Arcanum.slnx. The operator script publishes and runs it. -->
  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>RetroDownfall.Arcanum.GrimoireAdmission.Benchmarks</RootNamespace>

    <AssemblyName>RetroDownfall.Arcanum.GrimoireAdmission.Benchmarks</AssemblyName>

    <PublishAot>true</PublishAot>

    <IsAotCompatible>true</IsAotCompatible>

    <IsTrimmable>true</IsTrimmable>

    <InvariantGlobalization>true</InvariantGlobalization>

    <ServerGarbageCollection>false</ServerGarbageCollection>

    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

  </PropertyGroup>

  <ItemGroup>

    <ProjectReference Include="..\..\src\RetroDownfall.Arcanum.Infrastructure\RetroDownfall.Arcanum.Infrastructure.csproj" />

  </ItemGroup>

  <ItemGroup>

    <EmbeddedResource Include="grimoire-admission-workload-v1.json" />

  </ItemGroup>

  <ItemGroup>

    <PackageReference Update="Microsoft.Bcl.Memory" Version="10.0.10" />

  </ItemGroup>

</Project>
