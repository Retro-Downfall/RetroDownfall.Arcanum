<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverlet XPlat Code Coverage settings for Arcanum gates (docs/Arcanum.DESIGN.md section 13).
  Invoked by scripts/coverage.sh (dotnet test with this settings file).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            Aggregate gate assemblies: Core, Infrastructure, Api. The 80/70 aggregate floors in
            scripts/coverage_threshold.py are computed over these three only.
            Cli and Secrets are instrumented too so that they appear in the report with their own
            line and branch rates, but they are reported assemblies, not aggregate-gate assemblies:
            the threshold script gives each its own per-assembly floor (COVERAGE_CLI_LINE_TARGET,
            COVERAGE_SECRETS_LINE_TARGET) and removes them from the aggregate, so neither a large
            interactive surface nor a small platform-specific one can move the floors the three
            gate assemblies are held to. Api.DevHost is WAF-only and must stay out of the report.

            Cli: the Terminal.Gui Command Center UX is interactive and is not line-coverable, so every
            file under Cli/CommandCenter is excluded by file (ExcludeByFile below). All Terminal.Gui
            references live in that directory.

            Secrets: WindowsOsCredentialStore, MacOsCredentialStore and LinuxOsCredentialStore, and the
            three platform marker slots, are mutually exclusive by platform, so whichever do not match
            the runner would park structurally unreachable lines in the report on every lane; they are
            excluded by type. The historical WindowsOsCredentialStore defect is pinned by
            OsCredentialStoreRoundTripTests against the real backend on the Windows lane, not by this gate.
          -->
          <Include>[RetroDownfall.Arcanum.Core]*,[RetroDownfall.Arcanum.Infrastructure]*,[RetroDownfall.Arcanum.Api]*,[RetroDownfall.Arcanum.Cli]*,[RetroDownfall.Arcanum.Secrets]*</Include>
          <!--
            JSON source-gen contexts and EF migrations are not meaningful coverage surface.
            OpenAI /v1 contract POCOs use ExcludeFromCodeCoverage in source.
          -->
          <Exclude>[*]*.Migrations*,[*]*JsonContext*,[*]*JsonSerializerContext*,[RetroDownfall.Arcanum.Secrets]*WindowsOsCredentialStore*,[RetroDownfall.Arcanum.Secrets]*MacOsCredentialStore*,[RetroDownfall.Arcanum.Secrets]*LinuxOsCredentialStore*,[RetroDownfall.Arcanum.Secrets]*WindowsHostProcessToolsMarkerSlot*,[RetroDownfall.Arcanum.Secrets]*MacOsHostProcessToolsMarkerSlot*,[RetroDownfall.Arcanum.Secrets]*LinuxHostProcessToolsMarkerSlot*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverage</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**/*.cs,**/*.g.cs,**/Migrations/**/*.cs,**/RetroDownfall.Arcanum.Cli/CommandCenter/**/*.cs</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
